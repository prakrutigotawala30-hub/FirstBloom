@model FirstBloom.Models.Blog

@{
    ViewData["Title"] = "Blog Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="blog-admin-wrapper">

    <!-- PAGE HEADER -->
    <div class="blog-page-header">
        <div class="blog-page-header-left">
            <div class="blog-page-icon">
                <i class="fa-solid fa-eye"></i>
            </div>
            <div>
                <h2>Blog Details</h2>
                <p>View full blog post information</p>
            </div>
        </div>
        <div class="blog-header-actions">
            <a href="/Admin/Blog/Edit/@Model.Id" class="blog-edit-btn">
                <i class="fa-solid fa-pen"></i> Edit
            </a>
            <a href="/Admin/Blog" class="blog-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to Blogs
            </a>
        </div>
    </div>

    <div class="blog-form-card">

        <!-- SECTION 1 -->
        <div class="blog-form-section-header">
            <div class="blog-section-num">01</div>
            <div>
                <h5>Basic Information</h5>
                <p>Blog post title and descriptions</p>
            </div>
        </div>

        <div class="blog-detail-grid">
            <div class="blog-detail-item full">
                <span class="blog-detail-label">Title</span>
                <span class="blog-detail-value">@Model.Title</span>
            </div>
            <div class="blog-detail-item full">
                <span class="blog-detail-label">Short Description</span>
                <span class="blog-detail-value">@Model.ShortDescription</span>
            </div>
            <div class="blog-detail-item full">
                <span class="blog-detail-label">Image URL</span>
                <span class="blog-detail-value">@Model.ImageUrl</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="blog-image-preview">
                <img src="@Model.ImageUrl" alt="@Model.Title" />
            </div>
        }

        <!-- SECTION 2 -->
        <div class="blog-form-section-header" style="margin-top:30px;">
            <div class="blog-section-num">02</div>
            <div>
                <h5>Blog Details</h5>
                <p>Author, category and read time</p>
            </div>
        </div>

        <div class="blog-detail-grid">
            <div class="blog-detail-item">
                <span class="blog-detail-label">Author</span>
                <span class="blog-detail-value">@Model.Author</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Category</span>
                <span class="blog-detail-value">@Model.Category</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Read Time</span>
                <span class="blog-detail-value">@Model.ReadTime</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Published Date</span>
                <span class="blog-detail-value">
                    @Model.PublishedDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Status</span>
                <span class="blog-detail-value">
                    @if (Model.IsPublished)
                    {
                        <span class="blog-badge-published">Published</span>
                    }
                    else
                    {
                        <span class="blog-badge-draft">Draft</span>
                    }
                </span>
            </div>
        </div>

        <!-- SECTION 3 -->
        <div class="blog-form-section-header" style="margin-top:30px;">
            <div class="blog-section-num">03</div>
            <div>
                <h5>Full Content</h5>
                <p>The complete blog post content</p>
            </div>
        </div>

        <div class="blog-content-preview">
            @Html.Raw(Model.Description)
        </div>

        <!-- ACTIONS -->
        <div class="blog-form-actions">
            <a href="/Admin/Blog/Delete/@Model.Id" class="blog-delete-btn">
                <i class="fa-solid fa-trash"></i> Delete
            </a>
            <a href="/Admin/Blog/Edit/@Model.Id" class="blog-submit-btn">
                <i class="fa-solid fa-pen"></i> Edit Blog
            </a>
        </div>

    </div>
</div>

