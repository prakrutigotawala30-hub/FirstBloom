@model FirstBloom.Models.Blog

@{
    ViewData["Title"] = "Delete Blog";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="blog-admin-wrapper">

    <!-- PAGE HEADER -->
    <div class="blog-page-header">
        <div class="blog-page-header-left">
            <div class="blog-page-icon red">
                <i class="fa-solid fa-trash"></i>
            </div>
            <div>
                <h2>Delete Blog</h2>
                <p>Permanently remove this blog post</p>
            </div>
        </div>
        <a href="/Admin/Blog" class="blog-back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Blogs
        </a>
    </div>

    <div class="blog-form-card">

        <!-- WARNING -->
        <div class="blog-warning-box">
            <i class="fa-solid fa-triangle-exclamation"></i>
            Are you sure you want to delete this blog post? This action cannot be undone.
        </div>

        <!-- BLOG DETAILS -->
        <div class="blog-form-section-header">
            <div class="blog-section-num red">01</div>
            <div>
                <h5>Blog Details</h5>
                <p>Review the blog post before deleting</p>
            </div>
        </div>

        <div class="blog-detail-grid">
            <div class="blog-detail-item">
                <span class="blog-detail-label">Title</span>
                <span class="blog-detail-value">@Model.Title</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Category</span>
                <span class="blog-detail-value">@Model.Category</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Author</span>
                <span class="blog-detail-value">@Model.Author</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Date</span>
                <span class="blog-detail-value">
                    @Model.PublishedDate.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Read Time</span>
                <span class="blog-detail-value">@Model.ReadTime</span>
            </div>
            <div class="blog-detail-item">
                <span class="blog-detail-label">Status</span>
                <span class="blog-detail-value">
                    @if (Model.IsPublished)
                    {
                        <span class="blog-badge-published">Published</span>
                    }
                    else
                    {
                        <span class="blog-badge-draft">Draft</span>
                    }
                </span>
            </div>
        </div>

        <!-- FORM ACTIONS -->
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div class="blog-form-actions">
                <a href="/Admin/Blog" class="blog-cancel-btn">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
                <button type="submit" class="blog-delete-btn">
                    <i class="fa-solid fa-trash"></i> Yes, Delete
                </button>
            </div>
        </form>

    </div>
</div>

<style>
    .blog-admin-wrapper {
        padding: 30px;
        background: #f0f2f5;
        min-height: 100vh;
    }

    .blog-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .blog-page-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .blog-page-icon {
        width: 45px;
        height: 45px;
        background: #e8f0fe;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a3c8f;
        font-size: 1.2rem;
    }

        .blog-page-icon.red {
            background: #fef2f2;
            color: #dc2626;
        }

    .blog-page-header h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #1a3c8f;
    }

    .blog-page-header p {
        margin: 0;
        font-size: 0.83rem;
        color: #8a94a6;
    }

    .blog-back-btn {
        background: white;
        color: #374151;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .blog-back-btn:hover {
            background: #f0f2f5;
            color: #374151;
        }

    .blog-form-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .blog-warning-box {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #dc2626;
        padding: 14px 18px;
        border-radius: 8px;
        font-size: 0.88rem;
        margin-bottom: 24px;
        font-weight: 600;
    }

        .blog-warning-box i {
            margin-right: 8px;
        }

    .blog-form-section-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f0f2f5;
    }

    .blog-section-num {
        width: 36px;
        height: 36px;
        background: #1a3c8f;
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        flex-shrink: 0;
    }

        .blog-section-num.red {
            background: #dc2626;
        }

    .blog-form-section-header h5 {
        margin: 0;
        font-weight: 700;
        color: #1a3c8f;
        font-size: 0.95rem;
    }

    .blog-form-section-header p {
        margin: 0;
        font-size: 0.8rem;
        color: #8a94a6;
    }

    .blog-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 30px;
    }

    .blog-detail-item {
        background: #f8f9fb;
        border-radius: 8px;
        padding: 14px 16px;
    }

    .blog-detail-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 700;
        color: #8a94a6;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .blog-detail-value {
        font-size: 0.88rem;
        color: #374151;
        font-weight: 600;
    }

    .blog-badge-published {
        background: #f0fdf4;
        color: #16a34a;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .blog-badge-draft {
        background: #fff7ed;
        color: #ea580c;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 600;
    }

    .blog-form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        border-top: 1px solid #f0f2f5;
    }

    .blog-cancel-btn {
        background: white;
        color: #374151;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .blog-cancel-btn:hover {
            background: #f0f2f5;
            color: #374151;
        }

    .blog-delete-btn {
        background: #dc2626;
        color: white;
        padding: 10px 24px;
        border-radius: 8px;
        border: none;
        font-size: 0.88rem;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .blog-delete-btn:hover {
            background: #b91c1c;
        }
</style>