@model FirstBloom.Models.Blog

@{
    ViewData["Title"] = "Delete Blog";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center my-4">
        <h2>Delete Blog</h2>
        <a href="/Admin/Blog" class="btn btn-secondary">← Back to List</a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="alert alert-danger">
                Are you sure you want to delete this blog post? This action cannot be undone.
            </div>

            <table class="table table-bordered">
                <tr>
                    <th>Title</th>
                    <td>@Model.Title</td>
                </tr>
                <tr>
                    <th>Category</th>
                    <td>@Model.Category</td>
                </tr>
                <tr>
                    <th>Author</th>
                    <td>@Model.Author</td>
                </tr>
                <tr>
                    <th>Date</th>
                    <td>@Model.PublishedDate.ToString("dd MMM yyyy")</td>
                </tr>
                <tr>
                    <th>Status</th>
                    <td>
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Draft</span>
                        }
                    </td>
                </tr>
            </table>

            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a href="/Admin/Blog" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>