            color: #1a3c8f;
        }

        .blog-table-header p {
            margin: 0;
            font-size: 0.8rem;
            color: #8a94a6;
        }

    .blog-record-count {
        background: #f0f2f5;
        color: #8a94a6;
        padding: 4px 12px;
        border-radius: 20px;
