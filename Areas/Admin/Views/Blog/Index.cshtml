    }

    .blog-stat-card h3 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700;
        color: #1a3c8f;
    }

    .blog-table-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
