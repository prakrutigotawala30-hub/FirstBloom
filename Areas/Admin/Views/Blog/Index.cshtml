            background: #e8f0fe;
            color: #1a3c8f;
        }

        .blog-stat-icon.green {
            background: #f0fdf4;
            color: #16a34a;
        }

        .blog-stat-icon.orange {
            background: #fff7ed;
            color: #ea580c;
        }

    .blog-stat-card p {
