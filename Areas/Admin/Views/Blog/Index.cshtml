    }

    .blog-table {
        width: 100%;
        border-collapse: collapse;
    }

        .blog-table thead tr {
            background: #f8f9fb;
        }

        .blog-table th {
            padding: 12px 20px;
            text-align: left;
            font-size: 0.75rem;
            font-weight: 700;
            color: #8a94a6;
            letter-spacing: 0.5px;
        }

        .blog-table td {
            padding: 14px 20px;
            font-size: 0.88rem;
            color: #374151;
            border-bottom: 1px solid #f0f2f5;
        }

        .blog-table tbody tr:hover {
            background: #f8f9fb;
        }

    .blog-badge-published {
        background: #f0fdf4;
        color: #16a34a;
        padding: 4px 12px;
        border-radius: 20px;
