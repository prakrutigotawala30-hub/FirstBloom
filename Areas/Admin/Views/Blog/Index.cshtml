    }

    .blog-btn-view:hover {
        background: #1a3c8f;
        color: white;
    }

    .blog-btn-edit:hover {
        background: #ca8a04;
        color: white;
    }

    .blog-btn-delete:hover {
        background: #dc2626;
        color: white;
    }

    .blog-empty-state {
        padding: 60px 20px;
