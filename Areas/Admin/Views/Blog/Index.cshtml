@model List<FirstBloom.Models.Blog>

@{
    ViewData["Title"] = "Manage Blogs";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    var totalBlogs = Model.Count;
    var publishedBlogs = Model.Count(b => b.IsPublished);
    var draftBlogs = Model.Count(b => !b.IsPublished);
}

<div class="blog-admin-wrapper">

    <!-- PAGE HEADER -->
    <div class="blog-page-header">
        <div class="blog-page-header-left">
            <div class="blog-page-icon">
                <i class="fa-solid fa-newspaper"></i>
            </div>
            <div>
                <h2>Manage Blogs</h2>
                <p>Create and manage blog posts for the website</p>
            </div>
        </div>
        <a href="/Admin/Blog/Create" class="blog-add-btn">
            <i class="fa-solid fa-plus"></i> Add New Blog
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="blog-alert-success">
            <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    <!-- STATS CARDS -->
    <div class="blog-stats-row">
        <div class="blog-stat-card">
            <div class="blog-stat-icon blue">
                <i class="fa-solid fa-newspaper"></i>
            </div>
            <div>
                <p>Total Blogs</p>
                <h3>@totalBlogs</h3>
            </div>
        </div>
        <div class="blog-stat-card">
            <div class="blog-stat-icon green">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <p>Published</p>
                <h3>@publishedBlogs</h3>
            </div>
        </div>
        <div class="blog-stat-card">
            <div class="blog-stat-icon orange">
                <i class="fa-solid fa-file-lines"></i>
            </div>
            <div>
                <p>Drafts</p>
                <h3>@draftBlogs</h3>
            </div>
        </div>
    </div>

    <!-- BLOG TABLE -->
    <div class="blog-table-card">
        <div class="blog-table-header">
            <div>
                <h5>Blog List</h5>
                <p>View and manage all blog posts</p>
            </div>
            <span class="blog-record-count">@totalBlogs Records</span>
        </div>

        @if (!Model.Any())
        {
            <div class="blog-empty-state">
                <div class="blog-empty-icon">
                    <i class="fa-solid fa-newspaper"></i>
                </div>
                <h5>No Blog Posts Found</h5>
                <p>You haven't created any blog posts yet.</p>
                <a href="/Admin/Blog/Create" class="blog-add-btn">
                    <i class="fa-solid fa-plus"></i> Add New Blog
                </a>
            </div>
        }
        else
        {
            <table class="blog-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>TITLE</th>
                        <th>CATEGORY</th>
                        <th>AUTHOR</th>
                        <th>DATE</th>
                        <th>STATUS</th>
                        <th>ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var blog in Model)
                    {
                        <tr>
                            <td>@blog.Id</td>
                            <td>@blog.Title</td>
                            <td>@blog.Category</td>
                            <td>@blog.Author</td>
                            <td>@blog.PublishedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (blog.IsPublished)
                                {
                                    <span class="blog-badge-published">Published</span>
                                }
                                else
                                {
                                    <span class="blog-badge-draft">Draft</span>
                                }
                            </td>
                            <td>
                                <div class="blog-actions">
                                    <a asp-area="Admin"
                                       asp-controller="Blog"
                                       asp-action="Details"
                                       asp-route-id="@blog.Id"
                                       class="blog-btn-view">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a asp-area="Admin"
                                       asp-controller="Blog"
                                       asp-action="Edit"
                                       asp-route-id="@blog.Id"
                                       class="blog-btn-edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <a asp-area="Admin"
                                       asp-controller="Blog"
                                       asp-action="Delete"
                                       asp-route-id="@blog.Id"
                                       class="blog-btn-delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

