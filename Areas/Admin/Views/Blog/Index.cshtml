    }

    .blog-empty-icon {
        width: 64px;
        height: 64px;
        background: #f0f2f5;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 16px;
        font-size: 1.5rem;
        color: #8a94a6;
    }

    .blog-empty-state h5 {
        font-weight: 700;
        color: #374151;
