    .blog-stats-row {
        display: flex;
        gap: 16px;
        margin-bottom: 24px;
    }

    .blog-stat-card {
        background: white;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 16px;
        flex: 1;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .blog-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

