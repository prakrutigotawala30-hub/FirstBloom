    .blog-cancel-btn {
        background: white;
        color: #374151;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
