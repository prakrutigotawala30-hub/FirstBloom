        font-size: 0.8rem;
        color: #8a94a6;
    }

    .blog-form-group {
        margin-bottom: 18px;
        flex: 1;
    }

    .blog-label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 6px;
    }

    .required {
