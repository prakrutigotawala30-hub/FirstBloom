        padding: 16px;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 16px;
    }

    .blog-toggle-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .blog-toggle-icon.green {
            background: #f0fdf4;
            color: #16a34a;
        }

    .blog-toggle-text {
        flex: 1;
    }

        .blog-toggle-text strong {
            font-size: 0.88rem;
            color: #374151;
        }

        .blog-toggle-text p {
            margin: 0;
            font-size: 0.78rem;
            color: #8a94a6;
        }

    .blog-toggle-input {
        display: none;
    }

    .blog-toggle-label {
        width: 44px;
        height: 24px;
        background: #e5e7eb;
        border-radius: 12px;
        cursor: pointer;
        position: relative;
        transition: background 0.2s;
