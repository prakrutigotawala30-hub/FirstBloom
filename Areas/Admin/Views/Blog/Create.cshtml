        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1a3c8f;
        font-size: 1.2rem;
    }

    .blog-page-header h2 {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #1a3c8f;
    }

    .blog-page-header p {
        margin: 0;
        font-size: 0.83rem;
        color: #8a94a6;
    }

    .blog-back-btn {
        background: white;
        color: #374151;
        padding: 10px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        border: 1px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 6px;
    }

        .blog-back-btn:hover {
            background: #f0f2f5;
            color: #374151;
        }

    .blog-form-card {
        background: white;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    }

    .blog-form-section-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 20px;
        padding-bottom: 16px;
        border-bottom: 1px solid #f0f2f5;
    }

    .blog-section-num {
        width: 36px;
        height: 36px;
        background: #1a3c8f;
        color: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .blog-form-section-header h5 {
        margin: 0;
        font-weight: 700;
        color: #1a3c8f;
