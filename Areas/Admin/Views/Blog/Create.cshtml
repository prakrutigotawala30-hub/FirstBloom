@model FirstBloom.Models.Blog

@{
    ViewData["Title"] = "Create Blog";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="blog-admin-wrapper">

    <!-- PAGE HEADER -->
    <div class="blog-page-header">
        <div class="blog-page-header-left">
            <div class="blog-page-icon">
                <i class="fa-solid fa-newspaper"></i>
            </div>
            <div>
                <h2>Create Blog</h2>
                <p>Add a new blog post to the website</p>
            </div>
        </div>
        <a href="/Admin/Blog" class="blog-back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Blogs
        </a>
    </div>

    <div class="blog-form-card">

        <!-- SECTION 1 -->
        <div class="blog-form-section-header">
            <div class="blog-section-num">01</div>
            <div>
                <h5>Basic Information</h5>
                <p>Enter the blog post title and descriptions</p>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="blog-form-group">
                <label class="blog-label">Title <span class="required">*</span></label>
                <input asp-for="Title" class="blog-input"
                       placeholder="Enter blog title" />
                <span asp-validation-for="Title" class="blog-error"></span>
            </div>

            <div class="blog-form-group">
                <label class="blog-label">Short Description</label>
                <textarea asp-for="ShortDescription" class="blog-input"
                          rows="2"
                          placeholder="Brief summary shown on blog card"></textarea>
            </div>

            <div class="blog-form-group">
                <label class="blog-label">Full Content</label>
                <textarea asp-for="Description" class="blog-input"
                          rows="8"
                          placeholder="Full blog content (HTML supported)"></textarea>
            </div>

            <div class="blog-form-group">
                <label class="blog-label">Image URL</label>
                <input asp-for="ImageUrl" class="blog-input"
                       placeholder="e.g. /images/programs/play-group.jpg" />
            </div>

            <!-- SECTION 2 -->
            <div class="blog-form-section-header" style="margin-top:30px;">
                <div class="blog-section-num">02</div>
                <div>
                    <h5>Blog Details</h5>
                    <p>Set the author, category and read time</p>
                </div>
            </div>

            <div class="blog-form-row">
                <div class="blog-form-group">
                    <label class="blog-label">Author</label>
                    <input asp-for="Author" class="blog-input" />
                </div>

                <div class="blog-form-group">
                    <label class="blog-label">Category</label>
                    <select asp-for="Category" class="blog-input">
                        <option value="Education Tips">Education Tips</option>
                        <option value="Child Development">Child Development</option>
                        <option value="Parenting">Parenting</option>
                        <option value="Activities">Activities</option>
                        <option value="School Life">School Life</option>
                    </select>
                </div>

                <div class="blog-form-group">
                    <label class="blog-label">Read Time</label>
                    <input asp-for="ReadTime" class="blog-input"
                           placeholder="e.g. 5 min read" />
                </div>
            </div>

            <!-- SECTION 3 -->
            <div class="blog-form-section-header" style="margin-top:30px;">
                <div class="blog-section-num">03</div>
                <div>
                    <h5>Publishing Status</h5>
                    <p>Control the visibility of this blog post</p>
                </div>
            </div>

            <div class="blog-toggle-row">
                <div class="blog-toggle-icon green">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="blog-toggle-text">
                    <strong>Publish Blog</strong>
                    <p>Published blogs are visible to all website visitors</p>
                </div>
                <input asp-for="IsPublished" type="checkbox"
                       class="blog-toggle-input" id="publishToggle" />
                <label class="blog-toggle-label" for="publishToggle"></label>
            </div>

            <div class="blog-info-box">
                <i class="fa-solid fa-circle-info"></i>
                Unpublished blogs are saved as drafts and not visible to visitors.
            </div>

            <!-- FORM ACTIONS -->
            <div class="blog-form-actions">
                <a href="/Admin/Blog" class="blog-cancel-btn">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
                <button type="submit" class="blog-submit-btn">
                    <i class="fa-solid fa-floppy-disk"></i> Create Blog
                </button>
            </div>

        </form>
    </div>
</div>

<style>
