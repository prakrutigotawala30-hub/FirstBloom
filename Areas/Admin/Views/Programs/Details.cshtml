@model FirstBloom.Models.Programs

@{
    ViewData["Title"] = "Program Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="fb-program-page">

    <div class="fb-program-container">

        <!-- HEADER -->
        <div class="fb-form-header">

            <div>

                <span class="fb-program-eyebrow">
                    FIRSTBLOOM ACADEMY
                </span>

                <h1>
                    Program <span>Details</span>
                </h1>

                <p>
                    View complete information about this program.
                </p>

            </div>

            <a asp-area="Admin"
               asp-controller="Programs"
               asp-action="Index"
               class="fb-form-back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Programs

            </a>

        </div>


        <!-- DETAILS CARD -->
        <div class="fb-details-card">

            <!-- TOP -->
            <div class="fb-details-top">

                <div class="fb-details-program">

                    <div class="fb-details-image">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.ProgramName" />
                        }
                        else
                        {
                            <i class="fa-solid fa-graduation-cap"></i>
                        }

                    </div>

                    <div>

                        <h2>
                            @Model.ProgramName
                        </h2>

                        <p>
                            FirstBloom Academy Program
                        </p>

                    </div>

                </div>


                @if (Model.IsActive)
                {
                    <span class="fb-details-status active">
                        <span></span>
                        Active Program
                    </span>
                }
                else
                {
                    <span class="fb-details-status inactive">
                        <span></span>
                        Inactive Program
                    </span>
                }

            </div>


            <!-- INFORMATION -->
            <div class="fb-details-body">

                <div class="fb-details-grid">

                    <!-- AGE -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon blue">

                            <i class="fa-solid fa-child"></i>

                        </div>

                        <div>

                            <span>Age Group</span>

                            <strong>
                                @Model.AgeGroup
                            </strong>

                        </div>

                    </div>


                    <!-- DURATION -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon purple">

                            <i class="fa-regular fa-clock"></i>

                        </div>

                        <div>

                            <span>Duration</span>

                            <strong>
                                @Model.Duration
                            </strong>

                        </div>

                    </div>


                    <!-- FEE -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon green">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                        </div>

                        <div>

                            <span>Program Fee</span>

                            <strong>
                                ₹@Model.Fee.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <!-- START DATE -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon orange">

                            <i class="fa-regular fa-calendar"></i>

                        </div>

                        <div>

                            <span>Start Date</span>

                            <strong>
                                @Model.StartDate.ToString("dd MMMM yyyy")
                            </strong>

                        </div>

                    </div>


                    <!-- CREATED -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon blue">

                            <i class="fa-solid fa-calendar-plus"></i>

                        </div>

                        <div>

                            <span>Created On</span>

                            <strong>
                                @Model.CreatedAt.ToString("dd MMMM yyyy")
                            </strong>

                        </div>

                    </div>


                    <!-- STATUS -->
                    <div class="fb-detail-item">

                        <div class="fb-detail-icon green">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <div>

                            <span>Status</span>

                            @if (Model.IsActive)
                            {
                                <strong class="fb-detail-status-text active">
                                    Active Program
                                </strong>
                            }
                            else
                            {
                                <strong class="fb-detail-status-text inactive">
                                    Inactive Program
                                </strong>
                            }

                        </div>

                    </div>

                </div>


                <!-- DESCRIPTION -->
                <div class="fb-description-box">

                    <div class="fb-description-icon">

                        <i class="fa-solid fa-align-left"></i>

                    </div>

                    <div>

                        <span>
                            Program Description
                        </span>

                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <p>
                                @Model.Description
                            </p>
                        }
                        else
                        {
                            <p class="fb-no-description">
                                No description has been added for this program.
                            </p>
                        }

                    </div>

                </div>


                <!-- IMAGE URL -->
                @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                {
                    <div class="fb-image-info">

                        <div class="fb-image-info-icon">

                            <i class="fa-regular fa-image"></i>

                        </div>

                        <div>

                            <span>
                                Image URL
                            </span>

                            <strong>
                                @Model.ImageUrl
                            </strong>

                        </div>

                    </div>
                }

            </div>


            <!-- FOOTER -->
            <div class="fb-details-footer">

                <a asp-action="Index"
                   class="fb-form-cancel">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back

                </a>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="fb-form-submit edit">

                    <i class="fa-solid fa-pen"></i>

                    Edit Program

                </a>

            </div>

        </div>

    </div>

</div>