@model FirstBloom.Models.Programs

@{
    ViewData["Title"] = "Create Program";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="fb-program-page">

    <div class="fb-program-container">

        <!-- HEADER -->
        <div class="fb-form-header">

            <div>

                <span class="fb-program-eyebrow">
                    FIRSTBLOOM ACADEMY
                </span>

                <h1>
                    Create <span>Program</span>
                </h1>

                <p>
                    Add a new academic program to FirstBloom Academy.
                </p>

            </div>

            <a asp-area="Admin"
               asp-controller="Programs"
               asp-action="Index"
               class="fb-form-back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Programs

            </a>

        </div>


        <!-- FORM CARD -->
        <div class="fb-form-card">

            <div class="fb-form-card-header">

                <div class="fb-form-card-icon">

                    <i class="fa-solid fa-graduation-cap"></i>

                </div>

                <div>

                    <h2>
                        Program Information
                    </h2>

                    <p>
                        Enter the details of the new academy program.
                    </p>

                </div>

            </div>


            <form asp-area="Admin"
                  asp-controller="Programs"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="fb-validation-summary">
                </div>


                <div class="fb-form-grid">

                    <!-- PROGRAM NAME -->
                    <div class="fb-form-group">

                        <label asp-for="ProgramName">
                            Program Name
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-solid fa-graduation-cap"></i>

                            <input asp-for="ProgramName"
                                   placeholder="Example: Nursery" />

                        </div>

                        <span asp-validation-for="ProgramName"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- AGE -->
                    <div class="fb-form-group">

                        <label asp-for="AgeGroup">
                            Age Group
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-solid fa-child"></i>

                            <input asp-for="AgeGroup"
                                   placeholder="Example: 3 - 4 Years" />

                        </div>

                        <span asp-validation-for="AgeGroup"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- DURATION -->
                    <div class="fb-form-group">

                        <label asp-for="Duration">
                            Duration
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-regular fa-clock"></i>

                            <input asp-for="Duration"
                                   placeholder="Example: 1 Year" />

                        </div>

                        <span asp-validation-for="Duration"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- FEE -->
                    <div class="fb-form-group">

                        <label asp-for="Fee">
                            Program Fee
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                            <input asp-for="Fee"
                                   type="number"
                                   step="0.01"
                                   placeholder="Example: 25000" />

                        </div>

                        <span asp-validation-for="Fee"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- START DATE -->
                    <div class="fb-form-group">

                        <label asp-for="StartDate">
                            Program Start Date
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-regular fa-calendar"></i>

                            <input asp-for="StartDate"
                                   type="date" />

                        </div>

                        <small>
                            Students will see this date when selecting
                            the program.
                        </small>

                        <span asp-validation-for="StartDate"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- STATUS -->
                    <div class="fb-form-group">

                        <label>
                            Program Status
                        </label>

                        <label class="fb-toggle">

                            <input asp-for="IsActive" />

                            <span class="fb-toggle-slider"></span>

                            <span class="fb-toggle-text">
                                Active Program
                            </span>

                        </label>

                    </div>


                    <!-- IMAGE -->
                    <div class="fb-form-group full">

                        <label asp-for="ImageUrl">
                            Image URL
                        </label>

                        <div class="fb-input-wrapper">

                            <i class="fa-regular fa-image"></i>

                            <input asp-for="ImageUrl"
                                   placeholder="/images/programs/nursery.jpg" />

                        </div>

                        <span asp-validation-for="ImageUrl"
                              class="fb-validation">
                        </span>

                    </div>


                    <!-- DESCRIPTION -->
                    <div class="fb-form-group full">

                        <label asp-for="Description">
                            Program Description
                        </label>

                        <textarea asp-for="Description"
                                  rows="6"
                                  placeholder="Enter program description"></textarea>

                        <span asp-validation-for="Description"
                              class="fb-validation">
                        </span>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="fb-form-actions">

                    <a asp-action="Index"
                       class="fb-form-cancel">

                        <i class="fa-solid fa-xmark"></i>

                        Cancel

                    </a>

                    <button type="submit"
                            class="fb-form-submit">

                        <i class="fa-solid fa-plus"></i>

                        Create Program

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}