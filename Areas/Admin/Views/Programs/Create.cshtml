@model FirstBloom.Models.Programs

@{
    ViewData["Title"] = "Create Program";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                Create Program
            </h1>

            <p class="text-muted mb-0">
                Add a new academic program.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Programs"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left"></i>
            Back
        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <form asp-area="Admin"
                  asp-controller="Programs"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-4">

                    <!-- PROGRAM NAME -->
                    <div class="col-md-6">

                        <label asp-for="ProgramName"
                               class="form-label fw-semibold">
                            Program Name
                        </label>

                        <input asp-for="ProgramName"
                               class="form-control"
                               placeholder="Example: Nursery" />

                        <span asp-validation-for="ProgramName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- AGE GROUP -->
                    <div class="col-md-6">

                        <label asp-for="AgeGroup"
                               class="form-label fw-semibold">
                            Age Group
                        </label>

                        <input asp-for="AgeGroup"
                               class="form-control"
                               placeholder="Example: 3 - 4 Years" />

                        <span asp-validation-for="AgeGroup"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DURATION -->
                    <div class="col-md-6">

                        <label asp-for="Duration"
                               class="form-label fw-semibold">
                            Duration
                        </label>

                        <input asp-for="Duration"
                               class="form-control"
                               placeholder="Example: 1 Year" />

                        <span asp-validation-for="Duration"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- FEE -->
                    <div class="col-md-6">

                        <label asp-for="Fee"
                               class="form-label fw-semibold">
                            Fee
                        </label>

                        <input asp-for="Fee"
                               type="number"
                               step="0.01"
                               class="form-control"
                               placeholder="Example: 25000" />

                        <span asp-validation-for="Fee"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- START DATE -->
                    <div class="col-md-6">

                        <label asp-for="StartDate"
                               class="form-label fw-semibold">

                            Program Start Date

                        </label>

                        <input asp-for="StartDate"
                               type="date"
                               class="form-control" />

                        <small class="text-muted">
                            This date will be shown automatically
                            to students when they select this program.
                        </small>

                        <span asp-validation-for="StartDate"
                              class="text-danger d-block">
                        </span>

                    </div>


                    <!-- ACTIVE -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Program Status
                        </label>

                        <div class="form-check mt-2">

                            <input asp-for="IsActive"
                                   class="form-check-input" />

                            <label asp-for="IsActive"
                                   class="form-check-label">

                                Active Program

                            </label>

                        </div>

                    </div>


                    <!-- IMAGE URL -->
                    <div class="col-12">

                        <label asp-for="ImageUrl"
                               class="form-label fw-semibold">
                            Image URL
                        </label>

                        <input asp-for="ImageUrl"
                               class="form-control"
                               placeholder="/images/programs/nursery.jpg" />

                        <span asp-validation-for="ImageUrl"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- DESCRIPTION -->
                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">
                            Description
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter program description"></textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-light border">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fa-solid fa-plus"></i>
                        Create Program

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}