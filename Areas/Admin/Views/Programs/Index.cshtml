@model IEnumerable<FirstBloom.Models.Programs>

@{
    ViewData["Title"] = "Programs";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                Programs
            </h1>

            <p class="text-muted mb-0">
                Manage academy programs and their start dates.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Programs"
           asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus"></i>
            Add Program

        </a>

    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">

            <i class="fa-solid fa-circle-check"></i>

            @TempData["SuccessMessage"]

        </div>
    }


    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Program
                            </th>

                            <th>
                                Age Group
                            </th>

                            <th>
                                Duration
                            </th>

                            <th>
                                Fee
                            </th>

                            <th>
                                Start Date
                            </th>

                            <th>
                                Status
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5 text-muted">

                                    No programs found.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var program in Model)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @program.ProgramName
                                        </strong>

                                    </td>


                                    <td>
                                        @program.AgeGroup
                                    </td>


                                    <td>
                                        @program.Duration
                                    </td>


                                    <td>
                                        ₹@program.Fee.ToString("N2")
                                    </td>


                                    <td>

                                        <span>
                                            @program.StartDate.ToString("dd MMM yyyy")
                                        </span>

                                    </td>


                                    <td>

                                        @if (program.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end">

                                        <a asp-action="Details"
                                           asp-route-id="@program.Id"
                                           class="btn btn-sm btn-outline-info">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@program.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@program.Id"
                                           class="btn btn-sm btn-outline-danger">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>