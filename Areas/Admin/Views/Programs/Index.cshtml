@model IEnumerable<FirstBloom.Models.Programs>

@{
    ViewData["Title"] = "Programs";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="fb-program-page">

    <div class="fb-program-container">

        <!-- HEADER -->
        <div class="fb-program-header">

            <div class="fb-program-header-content">

                <span class="fb-program-eyebrow">
                    FIRSTBLOOM ACADEMY
                </span>

                <h1>
                    Manage <span>Programs</span>
                </h1>

                <p>
                    Manage academy programs, age groups, fees,
                    durations and start dates.
                </p>

            </div>

            <a asp-area="Admin"
               asp-controller="Programs"
               asp-action="Create"
               class="fb-program-add-btn">

                <i class="fa-solid fa-plus"></i>

                Add Program

            </a>

        </div>


        <!-- SUCCESS -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="fb-program-success">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        <!-- CARD -->
        <div class="fb-program-card">

            <!-- TABLE HEADER -->
            <div class="fb-program-table-header">

                <div class="fb-program-table-title">

                    <div class="fb-program-table-icon">

                        <i class="fa-solid fa-graduation-cap"></i>

                    </div>

                    <div>

                        <h2>
                            Academy Programs
                        </h2>

                        <p>
                            Available programs at FirstBloom Academy
                        </p>

                    </div>

                </div>

                <div class="fb-program-count">

                    <i class="fa-solid fa-layer-group"></i>

                    @(Model?.Count() ?? 0) Programs

                </div>

            </div>


            <!-- TABLE -->
            <div class="fb-program-table-wrapper">

                <table class="fb-program-table">

                    <thead>

                        <tr>

                            <th>Program</th>

                            <th>Age Group</th>

                            <th>Duration</th>

                            <th>Fee</th>

                            <th>Start Date</th>

                            <th>Status</th>

                            <th class="fb-program-actions-heading">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>

                                <td colspan="7"
                                    class="fb-program-empty">

                                    <div class="fb-program-empty-icon">

                                        <i class="fa-solid fa-folder-open"></i>

                                    </div>

                                    <h3>
                                        No Programs Found
                                    </h3>

                                    <p>
                                        Start by adding your first academy program.
                                    </p>

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var program in Model)
                            {
                                <tr>

                                    <td>

                                        <div class="fb-program-name">

                                            <div class="fb-program-icon">

                                                <i class="fa-solid fa-child-reaching"></i>

                                            </div>

                                            <div>

                                                <strong>
                                                    @program.ProgramName
                                                </strong>

                                                <small>
                                                    FirstBloom Program
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="fb-program-age">

                                            <i class="fa-solid fa-users"></i>

                                            @program.AgeGroup

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fb-program-duration">

                                            <i class="fa-regular fa-clock"></i>

                                            @program.Duration

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fb-program-fee">
                                            ₹@program.Fee.ToString("N2")
                                        </span>

                                    </td>

                                    <td>

                                        <span class="fb-program-date">

                                            <i class="fa-regular fa-calendar"></i>

                                            @program.StartDate.ToString("dd MMM yyyy")

                                        </span>

                                    </td>

                                    <td>

                                        @if (program.IsActive)
                                        {
                                            <span class="fb-program-status active">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="fb-program-status inactive">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="fb-program-actions">

                                            <a asp-action="Details"
                                               asp-route-id="@program.Id"
                                               class="fb-program-action view"
                                               title="View">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@program.Id"
                                               class="fb-program-action edit"
                                               title="Edit">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@program.Id"
                                               class="fb-program-action delete"
                                               title="Delete">

                                                <i class="fa-solid fa-trash"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>


            @if (Model != null && Model.Any())
            {
                <div class="fb-program-footer">

                    <span class="fb-program-footer-text">

                        <i class="fa-solid fa-circle-info"></i>

                        Manage your academy programs from this page.

                    </span>

                    <span class="fb-program-footer-brand">

                        <i class="fa-solid fa-seedling"></i>

                        FirstBloom Academy

                    </span>

                </div>
            }

        </div>

    </div>

</div>