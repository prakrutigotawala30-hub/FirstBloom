@model FirstBloom.Models.Programs

@{
    ViewData["Title"] = "Delete Program";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="fb-program-page">

    <div class="fb-program-container">

        <!-- HEADER -->
        <div class="fb-form-header">

            <div>

                <span class="fb-program-eyebrow danger">
                    FIRSTBLOOM ACADEMY
                </span>

                <h1>
                    Delete <span class="danger-text">Program</span>
                </h1>

                <p>
                    Permanently remove a program from the system.
                </p>

            </div>

            <a asp-action="Index"
               class="fb-form-back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Back to Programs

            </a>

        </div>


        <!-- DELETE CARD -->
        <div class="fb-delete-card">

            <!-- HEADER -->
            <div class="fb-delete-card-header">

                <div class="fb-delete-warning-icon">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                </div>

                <div>

                    <h2>
                        Confirm Program Deletion
                    </h2>

                    <p>
                        Please review the program information before deleting it.
                    </p>

                </div>

            </div>


            <div class="fb-delete-body">

                <!-- WARNING -->
                <div class="fb-delete-main-warning">

                    <div class="fb-delete-circle">

                        <i class="fa-solid fa-trash-can"></i>

                    </div>

                    <div>

                        <h3>
                            Are you sure you want to delete this program?
                        </h3>

                        <p>
                            This action will permanently remove the selected
                            program from the system.
                        </p>

                    </div>

                </div>


                <!-- PROGRAM -->
                <div class="fb-delete-program">

                    <div class="fb-delete-program-image">

                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 alt="@Model.ProgramName" />
                        }
                        else
                        {
                            <i class="fa-solid fa-graduation-cap"></i>
                        }

                    </div>

                    <div>

                        <span>
                            PROGRAM
                        </span>

                        <strong>
                            @Model.ProgramName
                        </strong>

                    </div>

                </div>


                <!-- DETAILS -->
                <div class="fb-delete-grid">

                    <div class="fb-delete-detail">

                        <div class="fb-delete-detail-icon blue">

                            <i class="fa-solid fa-child"></i>

                        </div>

                        <div>

                            <span>Age Group</span>

                            <strong>
                                @Model.AgeGroup
                            </strong>

                        </div>

                    </div>


                    <div class="fb-delete-detail">

                        <div class="fb-delete-detail-icon purple">

                            <i class="fa-regular fa-clock"></i>

                        </div>

                        <div>

                            <span>Duration</span>

                            <strong>
                                @Model.Duration
                            </strong>

                        </div>

                    </div>


                    <div class="fb-delete-detail">

                        <div class="fb-delete-detail-icon green">

                            <i class="fa-solid fa-indian-rupee-sign"></i>

                        </div>

                        <div>

                            <span>Program Fee</span>

                            <strong>
                                ₹@Model.Fee.ToString("N2")
                            </strong>

                        </div>

                    </div>


                    <div class="fb-delete-detail">

                        <div class="fb-delete-detail-icon orange">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <div>

                            <span>Status</span>

                            @if (Model.IsActive)
                            {
                                <strong class="fb-delete-status active">
                                    <span></span>
                                    Active
                                </strong>
                            }
                            else
                            {
                                <strong class="fb-delete-status inactive">
                                    <span></span>
                                    Inactive
                                </strong>
                            }

                        </div>

                    </div>

                </div>


                <!-- IMPORTANT -->
                <div class="fb-delete-important">

                    <div>

                        <i class="fa-solid fa-triangle-exclamation"></i>

                    </div>

                    <div>

                        <strong>
                            Important
                        </strong>

                        <p>
                            If this program is already connected to students,
                            classes, admissions, fees or other academic records,
                            deleting it may cause database relationship problems.
                            In such cases, deactivating the program is safer.
                        </p>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="fb-delete-actions">

                    <a asp-action="Index"
                       class="fb-form-cancel">

                        <i class="fa-solid fa-xmark"></i>

                        Cancel

                    </a>

                    <form asp-area="Admin"
                          asp-controller="Programs"
                          asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />

                        <button type="submit"
                                class="fb-delete-confirm">

                            <i class="fa-solid fa-trash-can"></i>

                            Yes, Delete Program

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>