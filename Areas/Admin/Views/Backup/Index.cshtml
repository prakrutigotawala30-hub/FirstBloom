@model IEnumerable<FirstBloom.Areas.Admin.Controllers.BackupController.BackupFileViewModel>

@{
    ViewData["Title"] = "Database Backup";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/admin-backup.css"
      asp-append-version="true" />

<div class="fb-backup-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="backup-header">

        <div>
            <div class="backup-title-icon">
                <i class="fa-solid fa-database"></i>
            </div>

            <div>
                <h1>Database Backup</h1>

                <p>
                    Create and manage complete backups of
                    FirstBloom Academy database data.
                </p>
            </div>
        </div>

    </div>


    <!-- =========================================================
         ALERTS
    ========================================================== -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="backup-alert success">
            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="backup-alert error">
            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["ErrorMessage"]
            </span>
        </div>
    }


    <!-- =========================================================
         BACKUP OPTIONS
    ========================================================== -->

    <div class="backup-options">

        <!-- SQL SERVER -->

        <div class="backup-card sql-card">

            <div class="backup-card-icon">
                <i class="fa-solid fa-server"></i>
            </div>

            <div class="backup-card-content">

                <h2>SQL Server</h2>

                <p>
                    Create a complete SQL Server database
                    backup containing your application data.
                </p>

                <div class="backup-file-type">
                    <i class="fa-solid fa-file"></i>
                    .BAK database backup
                </div>

                <form asp-area="Admin"
                      asp-controller="Backup"
                      asp-action="BackupSqlServer"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="backup-button sql-button">

                        <i class="fa-solid fa-cloud-arrow-down"></i>

                        Create SQL Server Backup

                    </button>

                </form>

            </div>

        </div>


        <!-- SQLITE -->

        <div class="backup-card sqlite-card">

            <div class="backup-card-icon">
                <i class="fa-solid fa-database"></i>
            </div>

            <div class="backup-card-content">

                <h2>SQLite</h2>

                <p>
                    Create a complete SQLite database
                    snapshot containing your application data.
                </p>

                <div class="backup-file-type">
                    <i class="fa-solid fa-file"></i>
                    .DB database backup
                </div>

                <form asp-area="Admin"
                      asp-controller="Backup"
                      asp-action="BackupSqlite"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="backup-button sqlite-button">

                        <i class="fa-solid fa-cloud-arrow-down"></i>

                        Create SQLite Backup

                    </button>

                </form>

            </div>

        </div>

    </div>


    <!-- =========================================================
         BACKUP INFORMATION
    ========================================================== -->

    <div class="backup-info">

        <div class="info-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>

            <h3>Database Protection</h3>

            <p>
                Backups contain the complete database state,
                including student accounts, admission applications,
                programs, notices, settings and other stored data.
            </p>

            <small>
                Keep backup files in a secure location.
                They may contain sensitive application information.
            </small>

        </div>

    </div>


    <!-- =========================================================
         BACKUP FILES
    ========================================================== -->

    <div class="backup-files-section">

        <div class="section-heading">

            <div>
                <h2>
                    <i class="fa-solid fa-box-archive"></i>
                    Saved Backup Files
                </h2>

                <p>
                    Existing database backups stored on the server.
                </p>
            </div>

            <div class="backup-count">

                <span>
                    @Model.Count()
                </span>

                Backup(s)

            </div>

        </div>


        @if (!Model.Any())
        {
            <div class="empty-backups">

                <div class="empty-icon">
                    <i class="fa-solid fa-folder-open"></i>
                </div>

                <h3>No backups found</h3>

                <p>
                    Create your first SQL Server or SQLite
                    backup using the buttons above.
                </p>

            </div>
        }
        else
        {
            <div class="backup-table-wrapper">

                <table class="backup-table">

                    <thead>

                        <tr>
                            <th>Database</th>
                            <th>Backup File</th>
                            <th>Size</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var backup in Model)
                        {
                            <tr>

                                <td>

                                    @if (backup.Type == "SqlServer")
                                    {
                                        <span class="database-badge sql">
                                            <i class="fa-solid fa-server"></i>
                                            SQL Server
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="database-badge sqlite">
                                            <i class="fa-solid fa-database"></i>
                                            SQLite
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="backup-file-name">

                                        @if (backup.Type == "SqlServer")
                                        {
                                            <i class="fa-solid fa-file-circle-check"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-database"></i>
                                        }

                                        <span>
                                            @backup.FileName
                                        </span>

                                    </div>

                                </td>

                                <td>
                                    @backup.SizeFormatted
                                </td>

                                <td>
                                    @backup.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </td>

                                <td>

                                    <div class="backup-actions">

                                        <a asp-area="Admin"
                                           asp-controller="Backup"
                                           asp-action="Download"
                                           asp-route-type="@backup.Type"
                                           asp-route-fileName="@backup.FileName"
                                           class="action-button download">

                                            <i class="fa-solid fa-download"></i>

                                            Download

                                        </a>


                                        <form asp-area="Admin"
                                              asp-controller="Backup"
                                              asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this backup?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="type"
                                                   value="@backup.Type" />

                                            <input type="hidden"
                                                   name="fileName"
                                                   value="@backup.FileName" />

                                            <button type="submit"
                                                    class="action-button delete">

                                                <i class="fa-solid fa-trash"></i>

                                                Delete

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>