@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Access Denied - FirstBloom Academy</title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

            /* =========================================================
                       FIRSTBLOOM ACADEMY - ACCESS DENIED
                       ========================================================= */

            :root {
                --primary: #2563eb;
                --primary-dark: #1d4ed8;
                --text-dark: #1e293b;
                --text-muted: #64748b;
                --background: #f5f8fc;
                --white: #ffffff;
                --danger: #dc2626;
                --danger-light: #fef2f2;
                --danger-border: #fecaca;
            }


            /* =========================================================
                       PAGE
                       ========================================================= */

            body {
                min-height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 30px 15px;
                font-family: "Segoe UI", Arial, sans-serif;
                color: var(--text-dark);
                background: radial-gradient( circle at top left, rgba(37, 99, 235, 0.10), transparent 35% ), radial-gradient( circle at bottom right, rgba(59, 130, 246, 0.08), transparent 35% ), var(--background);
            }


            /* =========================================================
                       ACCESS CARD
                       ========================================================= */

            .access-card {
                width: 100%;
                max-width: 500px;
                padding: 42px 40px;
                background: var(--white);
                border: 1px solid rgba(226, 232, 240, 0.9);
                border-radius: 20px;
                box-shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
                text-align: center;
                position: relative;
                overflow: hidden;
            }


                /* Blue top border */

                .access-card::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 5px;
                    background: linear-gradient( 90deg, #2563eb, #3b82f6, #60a5fa );
                }


            /* =========================================================
                       ICON
                       ========================================================= */

            .access-icon {
                width: 82px;
                height: 82px;
                margin: 5px auto 25px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: var(--danger-light);
                border: 1px solid var(--danger-border);
                color: var(--danger);
                font-size: 38px;
                font-weight: 700;
            }


            /* =========================================================
                       ERROR CODE
                       ========================================================= */

            .error-code {
                margin: 0;
                color: var(--primary);
                font-size: 64px;
                line-height: 1;
                font-weight: 800;
                letter-spacing: -2px;
            }


            /* =========================================================
                       TITLE
                       ========================================================= */

            .access-card h2 {
                margin-top: 15px;
                margin-bottom: 10px;
                color: var(--text-dark);
                font-size: 25px;
                font-weight: 700;
            }


            /* =========================================================
                       DESCRIPTION
                       ========================================================= */

            .access-message {
                max-width: 380px;
                margin: 0 auto 28px;
                color: var(--text-muted);
                font-size: 14px;
                line-height: 1.7;
            }


            /* =========================================================
                       BUTTON
                       ========================================================= */

            .btn-login {
                min-width: 180px;
                height: 48px;
                padding: 10px 24px;
                border: none;
                border-radius: 10px;
                background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
                color: #ffffff;
                font-size: 14px;
                font-weight: 650;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                box-shadow: 0 7px 18px rgba(37, 99, 235, 0.22);
                transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }


                .btn-login:hover {
                    background: linear-gradient( 135deg, #1d4ed8, #1e40af );
                    color: #ffffff;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 22px rgba(37, 99, 235, 0.28);
                }


                .btn-login:active {
                    transform: translateY(0);
                }


            /* =========================================================
                       FOOTER
                       ========================================================= */

            .access-footer {
                margin-top: 28px;
                padding-top: 20px;
                border-top: 1px solid #eef2f7;
                color: #94a3b8;
                font-size: 12px;
            }


            .academy-name {
                color: var(--primary);
                font-weight: 600;
            }


            /* =========================================================
                       RESPONSIVE
                       ========================================================= */

            @@media (max-width: 576px) {

                body {
                    padding: 20px 12px;
                }

                .access-card {
                    padding: 35px 22px;
                    border-radius: 16px;
                }

                .error-code {
                    font-size: 55px;
                }

                .access-card h2 {
                    font-size: 22px;
                }

                .access-icon {
                    width: 72px;
                    height: 72px;
                    font-size: 32px;
                }

                .btn-login {
                    width: 100%;
                }
            }


            /* =========================================================
                       VERY SMALL DEVICES
                       ========================================================= */

            @@media (max-width: 380px) {

                .access-card {
                    padding: 30px 18px;
                }

                .error-code {
                    font-size: 48px;
                }
            }

    </style>

</head>


<body>

    <div class="access-card">


        <!-- ACCESS DENIED ICON -->

        <div class="access-icon">
            !
        </div>


        <!-- ERROR CODE -->

        <h1 class="error-code">
            403
        </h1>


        <!-- TITLE -->

        <h2>
            Access Denied
        </h2>


        <!-- MESSAGE -->

        <p class="access-message">
            You do not have permission to access this page.
            Please sign in with an authorized administrator
            account to continue.
        </p>


        <!-- LOGIN BUTTON -->

        <a asp-area="Admin"
           asp-controller="Account"
           asp-action="Login"
           class="btn-login">

            Back to Admin Login

        </a>


        <!-- FOOTER -->

        <div class="access-footer">

            <span class="academy-name">
                FirstBloom Academy
            </span>

            <br />

            Administrator Portal

        </div>

    </div>

</body>

</html>