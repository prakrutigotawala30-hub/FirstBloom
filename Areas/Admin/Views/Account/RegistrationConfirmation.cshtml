@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Registration Successful - FirstBloom Academy</title>


    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <style>
            body {
                min-height: 100vh;
                margin: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, #eef4ff, #f8f5ff);
                font-family: Arial, Helvetica, sans-serif;
            }

            .confirmation-card {
                width: 100%;
                max-width: 500px;
                background: #ffffff;
                border-radius: 20px;
                padding: 45px 35px;
                text-align: center;
                box-shadow: 0 15px 40px rgba(0, 0, 0, 0.10);
            }

            .success-icon {
                width: 80px;
                height: 80px;
                margin: 0 auto 25px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #dcfce7;
                color: #16a34a;
                font-size: 38px;
            }

            .confirmation-card h1 {
                color: #173b72;
                font-size: 28px;
                font-weight: 700;
                margin-bottom: 15px;
            }

            .confirmation-card p {
                color: #64748b;
                line-height: 1.7;
                margin-bottom: 12px;
            }

            .login-btn {
                display: inline-block;
                margin-top: 20px;
                padding: 13px 28px;
                border-radius: 10px;
                background: #2563eb;
                color: white;
                text-decoration: none;
                font-weight: 600;
                transition: 0.2s;
            }

                .login-btn:hover {
                    background: #1d4ed8;
                    color: white;
                }

            .brand {
                margin-bottom: 25px;
                color: #2563eb;
                font-size: 18px;
                font-weight: 700;
            }
    </style>
    ```

</head>

<body>

    ```
    <div class="confirmation-card">

        <div class="brand">
            FirstBloom Academy
        </div>

        <div class="success-icon">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <h1>Registration Successful!</h1>

        <p>
            Your Admin account has been created successfully.
        </p>

        <p>
            We have sent a confirmation email to your registered email address.
        </p>

        <p>
            Please check your inbox and click the
            <strong>Verify Email Address</strong> button.
        </p>

        <p>
            After verifying your email, you can log in to the
            FirstBloom Admin Panel.
        </p>

        <a asp-area="Admin"
           asp-controller="Account"
           asp-action="Login"
           class="login-btn">
            <i class="fa-solid fa-right-to-bracket me-2"></i>
            Go to Login
        </a>

    </div>

</body>
</html>
