@model FirstBloom.Models.ViewModels.AdminLoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>


    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Admin Login - FirstBloom Academy</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
            <style >
                /* =========================================================
                   FIRSTBLOOM ACADEMY - ADMIN LOGIN
                   ========================================================= */
                :root {
                    --primary: #2563eb;
                    --primary-dark: #1d4ed8;
                    --text-dark: #1e293b;
                    --text-muted: #64748b;
                    --border: #dbe3ef;
                    --background: #f5f8fc;
                    --white: #ffffff;
                    --danger: #dc2626;
                }


                /* =========================================================
                   PAGE
                   ========================================================= */

                body {
                    min-height: 100vh;
                    margin: 0;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    padding: 30px 15px;
                    font-family: "Segoe UI", Arial, sans-serif;
                    color: var(--text-dark);
                    background: radial-gradient( circle at top left, rgba(37, 99, 235, 0.10), transparent 35% ), radial-gradient( circle at bottom right, rgba(59, 130, 246, 0.08), transparent 35% ), var(--background);
                }


                /* =========================================================
                   LOGIN CARD
                   ========================================================= */

                .login-card {
                    width: 100%;
                    max-width: 430px;
                    padding: 38px 40px;
                    background: var(--white);
                    border: 1px solid rgba(226, 232, 240, 0.9);
                    border-radius: 20px;
                    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.10);
                    position: relative;
                    overflow: hidden;
                }


                    /* Blue top line */

                    .login-card::before {
                        content: "";
                        position: absolute;
                        top: 0;
                        left: 0;
                        right: 0;
                        height: 5px;
                        background: linear-gradient( 90deg, #2563eb, #3b82f6, #60a5fa );
                    }


                /* =========================================================
                   LOGO / HEADER
                   ========================================================= */

                .logo {
                    text-align: center;
                    margin-bottom: 30px;
                }

                    .logo h2 {
                        margin: 0;
                        color: var(--primary);
                        font-size: 27px;
                        font-weight: 750;
                        letter-spacing: -0.5px;
                    }

                    .logo p {
                        margin-top: 7px;
                        margin-bottom: 0;
                        color: var(--text-muted);
                        font-size: 14px;
                    }


                /* =========================================================
                   FORM LABEL
                   ========================================================= */

                .form-label {
                    display: block;
                    margin-bottom: 7px;
                    color: #334155;
                    font-size: 14px;
                    font-weight: 600;
                }


                /* =========================================================
                   INPUT
                   ========================================================= */

                .form-control {
                    width: 100%;
                    height: 48px;
                    padding: 10px 14px;
                    border: 1px solid var(--border);
                    border-radius: 10px;
                    background: #ffffff;
                    color: var(--text-dark);
                    font-size: 14px;
                    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
                }

                    .form-control::placeholder {
                        color: #94a3b8;
                    }

                    .form-control:hover {
                        border-color: #bfdbfe;
                    }

                    .form-control:focus {
                        border-color: var(--primary);
                        background: #ffffff;
                        outline: none;
                        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
                    }


                /* =========================================================
                   REMEMBER ME
                   ========================================================= */

                .form-check {
                    display: flex;
                    align-items: center;
                    gap: 8px;
                }

                .form-check-input {
                    width: 17px;
                    height: 17px;
                    margin-top: 0;
                    border: 1px solid #cbd5e1;
                    cursor: pointer;
                }

                    .form-check-input:checked {
                        background-color: var(--primary);
                        border-color: var(--primary);
                    }

                    .form-check-input:focus {
                        border-color: var(--primary);
                        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10);
                    }

                .form-check-label {
                    color: #475569;
                    font-size: 14px;
                    cursor: pointer;
                }


                /* =========================================================
                   LOGIN BUTTON
                   ========================================================= */

                .btn-login {
                    height: 50px;
                    border: none;
                    border-radius: 10px;
                    background: linear-gradient( 135deg, #2563eb, #1d4ed8 );
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 650;
                    letter-spacing: 0.1px;
                    box-shadow: 0 7px 18px rgba(37, 99, 235, 0.22);
                    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
                }

                    .btn-login:hover {
                        background: linear-gradient( 135deg, #1d4ed8, #1e40af );
                        color: #ffffff;
                        transform: translateY(-1px);
                        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.28);
                    }

                    .btn-login:active {
                        transform: translateY(0);
                        box-shadow: 0 5px 12px rgba(37, 99, 235, 0.20);
                    }


                /* =========================================================
                   VALIDATION
                   ========================================================= */

                .text-danger {
                    display: block;
                    margin-top: 5px;
                    color: var(--danger) !important;
                    font-size: 12px;
                }

                .validation-summary-errors {
                    padding: 12px 14px;
                    margin-bottom: 20px;
                    background: #fef2f2;
                    border: 1px solid #fecaca;
                    border-radius: 10px;
                    color: #b91c1c;
                    font-size: 13px;
                }

                    .validation-summary-errors ul {
                        margin: 0;
                        padding-left: 18px;
                    }

                    .validation-summary-errors li {
                        margin-bottom: 3px;
                    }

                        .validation-summary-errors li:last-child {
                            margin-bottom: 0;
                        }


                /* =========================================================
                   REGISTER LINK
                   ========================================================= */

                .login-card > .text-center {
                    margin-top: 25px !important;
                    padding-top: 20px;
                    border-top: 1px solid #eef2f7;
                }

                .login-card a {
                    color: var(--primary);
                    font-size: 14px;
                    font-weight: 600;
                    text-decoration: none;
                    transition: color 0.2s ease;
                }

                    .login-card a:hover {
                        color: var(--primary-dark);
                        text-decoration: underline;
                    }


                /* =========================================================
                   FORM SPACING
                   ========================================================= */

                .mb-3 {
                    margin-bottom: 19px !important;
                }

                .mb-4 {
                    margin-bottom: 24px !important;
                }


                /* =========================================================
                   RESPONSIVE
                   ========================================================= */

                @@media (max-width: 576px) {

                    body {
                        padding: 20px 12px;
                    }

                    .login-card {
                        padding: 30px 22px;
                        border-radius: 16px;
                    }

                    .logo {
                        margin-bottom: 25px;
                    }

                        .logo h2 {
                            font-size: 23px;
                        }

                    .form-control {
                        height: 46px;
                    }

                    .btn-login {
                        height: 48px;
                    }
                }


                /* =========================================================
                   VERY SMALL DEVICES
                   ========================================================= */

                @@media (max-width: 380px) {

                    .login-card {
                        padding: 25px 18px;
                    }

                    .logo h2 {
                        font-size: 21px;
                    }
                }

        </style>
    </style>

</head>

<body>

    <div class="login-card">

        <div class="logo">

            <h2>FirstBloom Academy</h2>

            <p class="text-muted">
                Administrator Login
            </p>

        </div>

        <form asp-action="Login"
              asp-controller="Account"
              asp-area="Admin"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">

                <label asp-for="Email"
                       class="form-label">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       placeholder="Enter admin email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label asp-for="Password"
                       class="form-label">
                </label>

                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>

            <div class="form-check mb-4">

                <input asp-for="RememberMe"
                       class="form-check-input" />

                <label asp-for="RememberMe"
                       class="form-check-label">
                </label>

            </div>

            <button type="submit"
                    class="btn btn-login w-100">

                Login

            </button>

        </form>

        <div class="text-center mt-4">

            <a asp-area="Admin"
               asp-controller="Account"
               asp-action="Register">

                Create Admin Account

            </a>

        </div>

    </div>

</body>
</html>