@model IEnumerable<FirstBloom.Models.AcademicYear>

@{
    ViewData["Title"] = "Academic Years";
}

<div class="academic-years-page">

    <!-- Page Header -->
    <div class="page-header">
        <div>
            <div class="page-title">
                <i class="fa-solid fa-calendar-days"></i>
                <div>
                    <h2>Academic Years</h2>
                    <p>Manage school academic years</p>
                </div>
            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="AcademicYears"
           asp-action="Create"
           class="btn-add">
            <i class="fa-solid fa-plus"></i>
            <span>Add Academic Year</span>
        </a>
    </div>


    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-message success-message">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
            <button type="button"
                    class="alert-close"
                    onclick="this.parentElement.remove();">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }


    <!-- Error Message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-message error-message">
            <i class="fa-solid fa-circle-exclamation"></i>
            <span>@TempData["Error"]</span>
            <button type="button"
                    class="alert-close"
                    onclick="this.parentElement.remove();">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }


    <!-- Summary Cards -->
    <div class="summary-grid">

        <div class="summary-card">
            <div class="summary-icon blue">
                <i class="fa-solid fa-calendar"></i>
            </div>

            <div class="summary-content">
                <span>Total Years</span>
                <strong>@Model.Count()</strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon green">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="summary-content">
                <span>Active Years</span>
                <strong>@Model.Count(x => x.IsActive)</strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon purple">
                <i class="fa-solid fa-star"></i>
            </div>

            <div class="summary-content">
                <span>Current Year</span>

                <strong>
                    @(Model.FirstOrDefault(x => x.IsCurrent)?.Name ?? "Not Set")
                </strong>
            </div>
        </div>


        <div class="summary-card">
            <div class="summary-icon orange">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div class="summary-content">
                <span>Inactive Years</span>
                <strong>@Model.Count(x => !x.IsActive)</strong>
            </div>
        </div>

    </div>


    <!-- Academic Years Table -->
    <div class="academic-card">

        <div class="card-header-custom">

            <div>
                <h3>Academic Year List</h3>
                <p>View and manage all academic years</p>
            </div>

            <div class="record-count">
                @Model.Count() Records
            </div>

        </div>


        <div class="table-wrapper">

            <table class="academic-table">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Academic Year</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Current</th>
                        <th class="actions-column">Actions</th>
                    </tr>
                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        int count = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Number -->
                                <td class="number-column">
                                    @count
                                </td>


                                <!-- Academic Year -->
                                <td>
                                    <div class="year-name">
                                        <div class="year-icon">
                                            <i class="fa-solid fa-calendar-days"></i>
                                        </div>

                                        <div>
                                            <strong>@item.Name</strong>

                                            @if (item.IsCurrent)
                                            {
                                                <small>Current academic year</small>
                                            }
                                        </div>
                                    </div>
                                </td>


                                <!-- Start Date -->
                                <td>
                                    <div class="date-value">
                                        <i class="fa-regular fa-calendar"></i>
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </div>
                                </td>


                                <!-- End Date -->
                                <td>
                                    <div class="date-value">
                                        <i class="fa-regular fa-calendar"></i>
                                        @item.EndDate.ToString("dd MMM yyyy")
                                    </div>
                                </td>


                                <!-- Status -->
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <span class="status-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>


                                <!-- Current -->
                                <td>
                                    @if (item.IsCurrent)
                                    {
                                        <span class="current-badge">
                                            <i class="fa-solid fa-star"></i>
                                            Current
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-area="Admin"
                                              asp-controller="AcademicYears"
                                              asp-action="SetCurrent"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="set-current-form">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="set-current-btn"
                                                    title="Set @item.Name as current academic year">

                                                <i class="fa-solid fa-star"></i>
                                                Set Current

                                            </button>

                                        </form>
                                    }
                                </td>


                                <!-- Actions -->
                                <td class="actions-column">

                                    <div class="action-buttons">

                                        <!-- View -->
                                        <a asp-area="Admin"
                                           asp-controller="AcademicYears"
                                           asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="action-btn view-btn"
                                           title="View Academic Year">

                                            <i class="fa-solid fa-eye"></i>
                                            <span>View</span>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-area="Admin"
                                           asp-controller="AcademicYears"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn"
                                           title="Edit Academic Year">

                                            <i class="fa-solid fa-pen"></i>
                                            <span>Edit</span>

                                        </a>


                                        <!-- Delete -->
                                        <a asp-area="Admin"
                                           asp-controller="AcademicYears"
                                           asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="action-btn delete-btn"
                                           title="Delete Academic Year">

                                            <i class="fa-solid fa-trash"></i>
                                            <span>Delete</span>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7">

                                <div class="empty-state">

                                    <div class="empty-icon">
                                        <i class="fa-solid fa-calendar-xmark"></i>
                                    </div>

                                    <h4>No Academic Years Found</h4>

                                    <p>
                                        You haven't created any academic years yet.
                                    </p>

                                    <a asp-area="Admin"
                                       asp-controller="AcademicYears"
                                       asp-action="Create"
                                       class="empty-add-btn">

                                        <i class="fa-solid fa-plus"></i>
                                        Add Academic Year

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


    <style>

    /* ================================
           PAGE
        ================================= */

    .academic-years-page {
        padding: 28px 30px 40px;
        background: #f7f9fc;
        min-height: calc(100vh - 72px);
    }


    /* ================================
           HEADER
        ================================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        gap: 20px;
    }

    .page-title {
        display: flex;
        align-items: center;
        gap: 14px;
    }

        .page-title > i {
            font-size: 24px;
            color: #0b459b;
        }

        .page-title h2 {
            margin: 0;
            color: #172033;
            font-size: 25px;
            font-weight: 700;
        }

        .page-title p {
            margin: 5px 0 0;
            color: #929baa;
            font-size: 13px;
        }


    /* ================================
           ADD BUTTON
        ================================= */

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #0b459b;
        color: #fff !important;
        text-decoration: none;
        border: none;
        border-radius: 8px;
        padding: 11px 17px;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
        cursor: pointer;
    }

        .btn-add:hover {
            background: #073b8f;
            transform: translateY(-1px);
            box-shadow: 0 5px 12px rgba(11, 69, 155, .18);
        }


    /* ================================
           ALERT
        ================================= */

    .alert-message {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px 15px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .success-message {
        background: #ecfdf3;
        color: #087443;
        border: 1px solid #b7ebcc;
    }

    .error-message {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
    }

    .alert-close {
        margin-left: auto;
        background: transparent;
        border: 0;
        color: inherit;
        cursor: pointer;
        font-size: 14px;
    }


    /* ================================
           SUMMARY
        ================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 17px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 11px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 2px 8px rgba(20, 35, 60, .03);
    }

    .summary-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

        .summary-icon.blue {
            background: #eaf2ff;
            color: #0b459b;
        }

        .summary-icon.green {
            background: #eafaf0;
            color: #16834d;
        }

        .summary-icon.purple {
            background: #f3edff;
            color: #7442c8;
        }

        .summary-icon.orange {
            background: #fff4e5;
            color: #d97706;
        }

    .summary-content span {
        display: block;
        color: #8a94a6;
        font-size: 11px;
        margin-bottom: 5px;
    }

    .summary-content strong {
        display: block;
        color: #172033;
        font-size: 18px;
        font-weight: 700;
    }


    /* ================================
           MAIN CARD
        ================================= */

    .academic-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 11px;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(20, 35, 60, .04);
    }

    .card-header-custom {
        padding: 19px 21px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header-custom h3 {
            margin: 0;
            font-size: 15px;
            color: #172033;
            font-weight: 700;
        }

        .card-header-custom p {
            margin: 4px 0 0;
            font-size: 11px;
            color: #929baa;
        }

    .record-count {
        background: #f1f5f9;
        color: #64748b;
        border-radius: 20px;
        padding: 6px 11px;
        font-size: 11px;
        font-weight: 600;
    }


    /* ================================
           TABLE
        ================================= */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .academic-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 950px;
    }

        .academic-table thead {
            background: #f8fafc;
        }

        .academic-table th {
            padding: 13px 17px;
            text-align: left;
            color: #667085;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .4px;
            border-bottom: 1px solid #e8edf4;
            white-space: nowrap;
        }

        .academic-table td {
            padding: 15px 17px;
            border-bottom: 1px solid #eef1f5;
            color: #344054;
            font-size: 12px;
            vertical-align: middle;
        }

        .academic-table tbody tr {
            transition: background .15s ease;
        }

            .academic-table tbody tr:hover {
                background: #fafcff;
            }

            .academic-table tbody tr:last-child td {
                border-bottom: none;
            }

    .number-column {
        width: 45px;
        color: #98a2b3 !important;
        font-weight: 600;
    }


    /* ================================
           YEAR NAME
        ================================= */

    .year-name {
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .year-icon {
        width: 36px;
        height: 36px;
        min-width: 36px;
        background: #edf4ff;
        color: #0b459b;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .year-name strong {
        display: block;
        color: #172033;
        font-size: 13px;
        font-weight: 700;
    }

    .year-name small {
        display: block;
        color: #0b459b;
        font-size: 9px;
        margin-top: 3px;
    }


    /* ================================
           DATE
        ================================= */

    .date-value {
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
        color: #475467;
    }

        .date-value i {
            color: #98a2b3;
            font-size: 12px;
        }


    /* ================================
           STATUS
        ================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 20px;
        padding: 5px 9px;
        font-size: 10px;
        font-weight: 600;
    }

        .status-badge.active {
            background: #ecfdf3;
            color: #087443;
        }

        .status-badge.inactive {
            background: #f2f4f7;
            color: #667085;
        }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }


    /* ================================
           CURRENT
        ================================= */

    .current-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #edf4ff;
        color: #0b459b;
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    .set-current-form {
        display: inline-block;
        margin: 0;
    }

    .set-current-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid #d7e3f5;
        background: #fff;
        color: #0b459b;
        border-radius: 6px;
        padding: 6px 9px;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

        .set-current-btn:hover {
            background: #edf4ff;
            border-color: #0b459b;
        }


    /* ================================
           ACTIONS
        ================================= */

    .actions-column {
        text-align: right !important;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 5px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-width: 34px;
        height: 31px;
        padding: 0 8px;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 10px;
        font-weight: 600;
        transition: all .2s ease;
        cursor: pointer;
    }

    .view-btn {
        background: #eef6ff;
        color: #1769aa !important;
    }

        .view-btn:hover {
            background: #dcecff;
        }

    .edit-btn {
        background: #fff7e6;
        color: #b76b00 !important;
    }

        .edit-btn:hover {
            background: #ffedc4;
        }

    .delete-btn {
        background: #fff0f1;
        color: #c6284f !important;
    }

        .delete-btn:hover {
            background: #ffe0e5;
        }


    /* ================================
           EMPTY STATE
        ================================= */

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .empty-state h4 {
        margin: 0 0 7px;
        color: #344054;
        font-size: 16px;
    }

    .empty-state p {
        margin: 0 0 18px;
        color: #98a2b3;
        font-size: 12px;
    }

    .empty-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #0b459b;
        color: #fff !important;
        text-decoration: none;
        padding: 9px 14px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
    }


    /* ================================
           RESPONSIVE
        ================================= */

    @@media (max-width: 1100px) {

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }


    @@media (max-width: 700px) {

        .academic-years-page {
            padding: 20px 15px 30px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .btn-add {
            width: 100%;
            justify-content: center;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .card-header-custom {
            align-items: flex-start;
            gap: 10px;
            flex-direction: column;
        }
    }

    </style>    