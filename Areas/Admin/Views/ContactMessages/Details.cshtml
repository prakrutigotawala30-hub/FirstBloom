@model FirstBloom.Models.ContactMessage

@{
    ViewData["Title"] = "Enquiry Details";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="contact-details-page">

    <!-- HEADER -->
    <div class="contact-page-header">

        <div>

            <span class="contact-label">
                CONTACT MANAGEMENT
            </span>

            <h1>
                Enquiry Details
            </h1>

            <p>
                View the complete message received from the website.
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="ContactMessages"
           asp-action="Index"
           class="contact-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Enquiries

        </a>

    </div>


    <!-- DETAILS CARD -->
    <div class="contact-details-card">

        <!-- CARD HEADER -->
        <div class="contact-details-header">

            <div class="contact-details-person">

                <div class="contact-details-avatar">
                    @(string.IsNullOrWhiteSpace(Model.Name)
                        ? "?"
                        : Model.Name.Substring(0, 1).ToUpper())
                </div>

                <div>

                    <h2>
                        @Model.Name
                    </h2>

                    <span>
                        @Model.Email
                    </span>

                </div>

            </div>


            @if (Model.IsRead)
            {
                <span class="message-status read">
                    <i class="fa-solid fa-envelope-open"></i>
                    Read
                </span>
            }
            else
            {
                <span class="message-status unread">
                    <i class="fa-solid fa-envelope"></i>
                    New
                </span>
            }

        </div>


        <!-- INFORMATION -->
        <div class="contact-details-info">

            <div class="contact-info-item">

                <span>
                    <i class="fa-solid fa-user"></i>
                    Name
                </span>

                <strong>
                    @Model.Name
                </strong>

            </div>


            <div class="contact-info-item">

                <span>
                    <i class="fa-solid fa-envelope"></i>
                    Email
                </span>

                <strong>
                    @Model.Email
                </strong>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Subject))
            {
                <div class="contact-info-item">

                    <span>
                        <i class="fa-solid fa-tag"></i>
                        Subject
                    </span>

                    <strong>
                        @Model.Subject
                    </strong>

                </div>
            }


            <div class="contact-info-item">

                <span>
                    <i class="fa-solid fa-calendar"></i>
                    Received
                </span>

                <strong>
                    @Model.CreatedAt.ToString("dd MMMM yyyy, hh:mm tt")
                </strong>

            </div>

        </div>


        <!-- MESSAGE -->
        <div class="contact-message-section">

            <div class="contact-message-heading">

                <i class="fa-solid fa-message"></i>

                <h3>
                    Message
                </h3>

            </div>


            <div class="contact-message-box">

                @if (!string.IsNullOrWhiteSpace(Model.Message))
                {
                    @Model.Message
                }
                else
                {
                    <span class="empty-message">
                        No message provided.
                    </span>
                }

            </div>

        </div>


        <!-- ACTIONS -->
        <div class="contact-details-actions">

            <a asp-area="Admin"
               asp-controller="ContactMessages"
               asp-action="Index"
               class="contact-btn cancel">

                <i class="fa-solid fa-arrow-left"></i>

                Back

            </a>


            @if (Model.IsRead)
            {
                <form asp-area="Admin"
                      asp-controller="ContactMessages"
                      asp-action="MarkAsUnread"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="contact-btn secondary">

                        <i class="fa-solid fa-envelope"></i>

                        Mark as Unread

                    </button>

                </form>
            }
            else
            {
                <form asp-area="Admin"
                      asp-controller="ContactMessages"
                      asp-action="MarkAsRead"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="contact-btn secondary">

                        <i class="fa-solid fa-envelope-open"></i>

                        Mark as Read

                    </button>

                </form>
            }


            <form asp-area="Admin"
                  asp-controller="ContactMessages"
                  asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to delete this enquiry?');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="contact-btn danger">

                    <i class="fa-solid fa-trash"></i>

                    Delete

                </button>

            </form>

        </div>

    </div>
</div>
