
@{
    ViewData["Title"] = "Reports";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-reports.css" />
}

<div class="admin-reports-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="reports-header">

        <div>
            <span class="reports-label">
                ADMINISTRATION
            </span>

            <h1>
                Reports & Analytics
            </h1>

            <p>
                Monitor FirstBloom Academy data, enquiries,
                admissions and website content.
            </p>
        </div>

        <div class="reports-header-icon">
            <i class="fa-solid fa-chart-column"></i>
        </div>

    </div>


    <!-- =========================================================
         MAIN STATISTICS
         ========================================================= -->

    <div class="reports-stats">

        <!-- PROGRAMS -->

        <a asp-area="Admin"
           asp-controller="Programs"
           asp-action="Index"
           class="report-stat-card programs-card">

            <div class="report-stat-icon">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>

            <div class="report-stat-content">

                <span>Total Programs</span>

                <h2>
                    @ViewBag.TotalPrograms
                </h2>

                <small>
                    View programs
                    <i class="fa-solid fa-arrow-right"></i>
                </small>

            </div>

        </a>


        <!-- ADMISSIONS -->

        <a asp-area="Admin"
           asp-controller="Admissions"
           asp-action="Index"
           class="report-stat-card admissions-card">

            <div class="report-stat-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <div class="report-stat-content">

                <span>Total Admissions</span>

                <h2>
                    @ViewBag.TotalAdmissions
                </h2>

                <small>
                    View applications
                    <i class="fa-solid fa-arrow-right"></i>
                </small>

            </div>

        </a>


        <!-- ENQUIRIES -->

        <a asp-area="Admin"
           asp-controller="ContactMessages"
           asp-action="Index"
           class="report-stat-card enquiries-card">

            <div class="report-stat-icon">
                <i class="fa-solid fa-envelope"></i>
            </div>

            <div class="report-stat-content">

                <span>Total Enquiries</span>

                <h2>
                    @ViewBag.TotalEnquiries
                </h2>

                <small>
                    View enquiries
                    <i class="fa-solid fa-arrow-right"></i>
                </small>

            </div>

        </a>


        <!-- BLOGS -->

        <a asp-area="Admin"
           asp-controller="Blog"
           asp-action="Index"
           class="report-stat-card blogs-card">

            <div class="report-stat-icon">
                <i class="fa-solid fa-newspaper"></i>
            </div>

            <div class="report-stat-content">

                <span>Total Blogs</span>

                <h2>
                    @ViewBag.TotalBlogs
                </h2>

                <small>
                    Manage blogs
                    <i class="fa-solid fa-arrow-right"></i>
                </small>

            </div>

        </a>

    </div>


    <!-- =========================================================
         SECONDARY DATA
         ========================================================= -->

    <div class="reports-secondary-grid">

        <a asp-area="Admin"
           asp-controller="Notice"
           asp-action="Index"
           class="report-mini-card">

            <div class="mini-icon notices">
                <i class="fa-solid fa-bullhorn"></i>
            </div>

            <div>
                <span>Notices</span>

                <strong>
                    @ViewBag.TotalNotices
                </strong>

                <small>Published notices</small>
            </div>

        </a>


        @* <a asp-area="Admin"
           asp-controller="FAQ"
           asp-action="Index"
           class="report-mini-card">

            <div class="mini-icon faqs">
                <i class="fa-solid fa-circle-question"></i>
            </div>

            <div>
                <span>FAQs</span>

                <strong>
                    @ViewBag.TotalFAQs
                </strong>

                <small>Questions</small>
            </div>

        </a> *@



        <a asp-area="Admin"
           asp-controller="AcademicYears"
           asp-action="Index"
           class="report-mini-card">

            <div class="mini-icon academic">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div>
                <span>Academic Years</span>

                <strong>
                    @ViewBag.TotalAcademicYears
                </strong>

                <small>Academic sessions</small>
            </div>

        </a>


        <div class="report-mini-card">

            <div class="mini-icon reads">
                <i class="fa-solid fa-eye"></i>
            </div>

            <div>
                <span>Notice Reads</span>

                <strong>
                    @ViewBag.TotalNoticeReads
                </strong>

                <small>Total reads</small>
            </div>

        </div>

    </div>


    <!-- =========================================================
         ENQUIRY ANALYTICS
         ========================================================= -->

    <div class="reports-grid">

        <div class="reports-card chart-card">

            <div class="reports-card-header">

                <div>

                    <span class="reports-small-label">
                        ENQUIRY ANALYTICS
                    </span>

                    <h3>
                        Monthly Enquiries
                    </h3>

                    <p>
                        Contact enquiries received during
                        @DateTime.Now.Year.
                    </p>

                </div>

                <div class="reports-card-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

            </div>

            <div class="reports-chart-container">

                <canvas id="enquiryChart"></canvas>

            </div>

        </div>


        <!-- ENQUIRY SUMMARY -->

        <div class="reports-card summary-card">

            <div class="reports-card-header">

                <div>

                    <span class="reports-small-label">
                        ENQUIRIES
                    </span>

                    <h3>
                        Enquiry Summary
                    </h3>

                    <p>
                        Current enquiry status.
                    </p>

                </div>

                <div class="reports-card-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>

            </div>


            <div class="enquiry-summary">

                <div class="summary-item">
                    <span>
                        <span class="summary-dot total"></span>
                        Total Enquiries
                    </span>

                    <strong>
                        @ViewBag.TotalEnquiries
                    </strong>
                </div>


                <div class="summary-item">
                    <span>
                        <span class="summary-dot read"></span>
                        Read
                    </span>

                    <strong>
                        @ViewBag.ReadEnquiries
                    </strong>
                </div>


                <div class="summary-item">
                    <span>
                        <span class="summary-dot unread"></span>
                        Unread
                    </span>

                    <strong>
                        @ViewBag.UnreadEnquiries
                    </strong>
                </div>


                <div class="summary-item">
                    <span>
                        <span class="summary-dot published"></span>
                        Published Blogs
                    </span>

                    <strong>
                        @ViewBag.PublishedBlogs
                    </strong>
                </div>


                <div class="summary-item">
                    <span>
                        <span class="summary-dot draft"></span>
                        Draft Blogs
                    </span>

                    <strong>
                        @ViewBag.DraftBlogs
                    </strong>
                </div>

            </div>

            <div class="summary-footer">

                <a asp-area="Admin"
                   asp-controller="ContactMessages"
                   asp-action="Index"
                   class="reports-view-btn">

                    View Enquiries

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ALL ENQUIRY DATA
         ========================================================= -->

    <div class="reports-card data-card">

        <div class="reports-card-header">

            <div>
                <span class="reports-small-label">
                    CONTACT DATA
                </span>

                <h3>
                    Recent Enquiries
                </h3>

                <p>
                    Latest parent enquiries received.
                </p>
            </div>

            <a asp-area="Admin"
               asp-controller="ContactMessages"
               asp-action="Index"
               class="reports-view-all">

                View All
                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>


        <div class="reports-table-wrapper">

            <table class="reports-table">

                <thead>

                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (ViewBag.RecentEnquiries != null)
                    {
                        foreach (var message in ViewBag.RecentEnquiries)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @message.Name
                                    </strong>
                                </td>

                                <td>
                                    @message.Email
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(message.Subject)
                                        ? "General Enquiry"
                                        : message.Subject)
                                </td>

                                <td>
                                    @message.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>

                                    @if (message.IsRead)
                                    {
                                        <span class="report-status read">
                                            <i class="fa-solid fa-check"></i>
                                            Read
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="report-status unread">
                                            <i class="fa-solid fa-circle"></i>
                                            Unread
                                        </span>
                                    }

                                </td>

                                <td>

                                    <a asp-area="Admin"
                                       asp-controller="ContactMessages"
                                       asp-action="Details"
                                       asp-route-id="@message.Id"
                                       class="report-action-btn">

                                        <i class="fa-solid fa-eye"></i>
                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================================
         ADMISSION DATA
         ========================================================= -->

    <div class="reports-card data-card admission-report-card">

        <div class="reports-card-header">

            <div>
                <span class="reports-small-label">
                    ADMISSION DATA
                </span>

                <h3>
                    Recent Admission Applications
                </h3>

                <p>
                    Latest applications submitted by parents.
                </p>
            </div>

            <a asp-area="Admin"
               asp-controller="Admissions"
               asp-action="Index"
               class="reports-view-all">

                View All
                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>


        <div class="reports-table-wrapper">

            <table class="reports-table admission-table">

                <thead>

                    <tr>
                        <th>Application</th>
                        <th>Child Name</th>
                        <th>Parent</th>
                        <th>Program</th>
                        <th>Academic Year</th>
                        <th>Status</th>
                        <th>Created</th>
                    </tr>

                </thead>

                <tbody>

                    @if (ViewBag.RecentAdmissions != null)
                    {
                        foreach (var admission in ViewBag.RecentAdmissions)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @admission.ApplicationNumber
                                    </strong>
                                </td>

                                <td>

                                    <div class="child-name">

                                        <strong>
                                            @admission.ChildFirstName
                                            @admission.ChildLastName
                                        </strong>

                                        <small>
                                            @admission.Gender
                                        </small>

                                    </div>

                                </td>

                                <td>

                                    <div class="parent-name">

                                        <strong>
                                            @admission.FatherName
                                        </strong>

                                        <small>
                                            @admission.ParentEmail
                                        </small>

                                    </div>

                                </td>

                                <td>
                                    @admission.Program
                                </td>

                                <td>
                                    @(admission.AcademicYear ?? "—")
                                </td>

                                <td>

                                    <span class="admission-status @admission.Status.ToString().ToLower()">
                                        @admission.Status
                                    </span>

                                </td>

                                <td>
                                    @admission.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================================
         BLOG DATA
         ========================================================= -->

    <div class="reports-card data-card">

        <div class="reports-card-header">

            <div>
                <span class="reports-small-label">
                    BLOG DATA
                </span>

                <h3>
                    Recent Blog Posts
                </h3>

                <p>
                    Latest articles created in FirstBloom Academy.
                </p>
            </div>

            <a asp-area="Admin"
               asp-controller="Blog"
               asp-action="Index"
               class="reports-view-all">

                View All
                <i class="fa-solid fa-arrow-right"></i>

            </a>

        </div>


        <div class="reports-blog-list">

            @if (ViewBag.RecentBlogs != null)
            {
                foreach (var blog in ViewBag.RecentBlogs)
                {
                    <a asp-area="Admin"
                       asp-controller="Blog"
                       asp-action="Details"
                       asp-route-id="@blog.Id"
                       class="report-blog-item">

                        <div class="report-blog-image">

                            @if (!string.IsNullOrWhiteSpace(blog.ImageUrl))
                            {
                                <img src="@blog.ImageUrl"
                                     alt="@blog.Title" />
                            }
                            else
                            {
                                <i class="fa-solid fa-newspaper"></i>
                            }

                        </div>


                        <div class="report-blog-content">

                            <strong>
                                @blog.Title
                            </strong>

                            <span>
                                @blog.Category
                                •
                                @blog.Author
                                •
                                @blog.ReadTime
                            </span>

                        </div>


                        @if (blog.IsPublished)
                        {
                            <span class="report-status read">
                                Published
                            </span>
                        }
                        else
                        {
                            <span class="report-status unread">
                                Draft
                            </span>
                        }

                    </a>
                }
            }

        </div>

    </div>


    <!-- =========================================================
         DATABASE INFORMATION
         ========================================================= -->

    <div class="reports-info-grid">

        <div class="reports-info-card">

            <div class="reports-info-icon">
                <i class="fa-solid fa-database"></i>
            </div>

            <div>

                <strong>
                    Live Database Data
                </strong>

                <p>
                    Statistics and records are loaded directly
                    from FirstBloomDB.
                </p>

            </div>

        </div>


        <div class="reports-info-card">

            <div class="reports-info-icon">
                <i class="fa-solid fa-chart-simple"></i>
            </div>

            <div>

                <strong>
                    Academy Overview
                </strong>

                <p>
                    Select any report card to open the corresponding
                    administration section.
                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const monthLabels =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.MonthLabels ?? new List<string>()
                )
            );

        const monthValues =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.MonthValues ?? new List<int>()
                )
            );


        const chartElement =
            document.getElementById("enquiryChart");


        if (chartElement) {

            new Chart(chartElement, {

                type: "line",

                data: {

                    labels: monthLabels,

                    datasets: [
                        {
                            label: "Enquiries",
                            data: monthValues,
                            borderWidth: 3,
                            tension: 0.4,
                            fill: true,
                            pointRadius: 4,
                            pointHoverRadius: 6
                        }
                    ]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {

                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            }

                        }

                    }

                }

            });

        }

    </script>

}