<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FirstBloom Admin
    </title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Admin Dashboard CSS -->
    <link rel="stylesheet"
          href="~/css/admin-dashboard.css"
          asp-append-version="true" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Admin Layout CSS -->
    <link rel="stylesheet"
          href="~/css/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-programs.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-programs-crud.css"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/admin-media-crud.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-contact-messages.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-blog.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-reports.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-settings.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin-backup.css"
          asp-append-version="true" />


    @RenderSection("Styles", required: false)
</head>


<body>

    <div class="admin-wrapper">

        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <aside class="admin-sidebar">

            <!-- BRAND -->

            <div class="admin-brand">

                <div class="admin-brand-icon">
                    ✿
                </div>

                <div>
                    <strong>FirstBloom</strong>
                    <small>ACADEMY</small>
                </div>

            </div>


            <!-- NAVIGATION -->

            <nav class="admin-nav">

                <!-- DASHBOARD -->

                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">

                    <i class="fa-solid fa-house"></i>

                    <span>Dashboard</span>

                </a>


                <!-- ADMISSIONS -->

                <a asp-area="Admin"
                   asp-controller="Admissions"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Admissions" ? "active" : "")">

                    <i class="fa-solid fa-user-plus"></i>

                    <span>Admissions</span>

                </a>

                <!-- STUDENTS -->

                <a asp-area="Admin"
                   asp-controller="Students"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Students" ? "active" : "")">

                    <i class="fa-solid fa-users"></i>

                    <span>Students</span>

                </a>
                

                <!-- USERS & ROLES -->

                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">

                    <i class="fa-solid fa-user-shield"></i>

                    <span>Users &amp; Roles</span>

                </a>


                <!-- ENQUIRIES -->

                <a asp-area="Admin"
                   asp-controller="ContactMessages"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Enquiries" ? "active" : "")">

                    <i class="fa-solid fa-envelope"></i>

                    <span>Enquiries</span>

                </a>


                <!-- PARENTS -->

                @* <a asp-area="Admin"
                   asp-controller="Parents"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Parents" ? "active" : "")">

                    <i class="fa-solid fa-user-group"></i>

                    <span>Parents</span>

                </a> *@


                <!-- PROGRAMS -->

                <a asp-area="Admin"
                   asp-controller="Programs"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Programs" ? "active" : "")">

                    <i class="fa-solid fa-graduation-cap"></i>

                    <span>Programs</span>

                </a>


                <!-- ACADEMIC YEARS -->

                <a asp-area="Admin"
                   asp-controller="AcademicYears"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "AcademicYears" ? "active" : "")">

                    <i class="fa-solid fa-calendar-days"></i>

                    <span>Academic Years</span>

                </a>


                @* <!-- EVENTS -->

                <a asp-area="Admin"
                   asp-controller="Events"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Events" ? "active" : "")">

                    <i class="fa-solid fa-calendar-check"></i>

                    <span>Events</span>

                </a> *@


                <!-- BLOG -->

                <a asp-area="Admin"
                   asp-controller="Blog"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Blog" ? "active" : "")">

                    <i class="fa-solid fa-newspaper"></i>

                    <span>Blog</span>

                </a>



                <!-- MEDIA LIBRARY -->

                <a asp-area="Admin"
                   asp-controller="Media"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Media" ? "active" : "")">

                    <i class="fa-solid fa-photo-film"></i>

                    <span>Media Library</span>

                </a>


                <!-- NOTICES -->

                <a asp-area="Admin"
                   asp-controller="Notice"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Notice" ? "active" : "")">

                    <i class="fa-solid fa-bullhorn"></i>

                    <span>Notices</span>

                </a>


                <!-- REPORTS -->

                <a asp-area="Admin"
                   asp-controller="Reports"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">

                    <i class="fa-solid fa-chart-column"></i>

                    <span>Reports</span>

                </a>

                <!-- SETTINGS -->

                <a asp-area="Admin"
                   asp-controller="Settings"
                   asp-action="Index"
                   class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")">

                    <i class="fa-solid fa-gear"></i>

                    <span>Settings</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Backup"
                   asp-action="Index">

                    <i class="fa-solid fa-database"></i>

                    <span>Backup</span>

                </a>

                <form asp-area=""
                      asp-controller="Home"
                      asp-action="Index"
                      method="post"
                      class="d-inline">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout-btn">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Logout</span>
                    </button>

                </form>
            </nav>

        </aside>


        <!-- ===================================================== -->
        <!-- MAIN CONTENT -->
        <!-- ===================================================== -->

        <main class="admin-main">

            <!-- TOPBAR -->

            <div class="admin-topbar">

                <div class="admin-topbar-left">

                    <button type="button"
                            class="admin-sidebar-toggle"
                            id="adminSidebarToggle"
                            aria-label="Toggle admin sidebar"
                            aria-expanded="true">

                        <i class="fa-solid fa-bars"></i>

                    </button>

                    <div class="admin-topbar-title">

                        <strong>
                            FirstBloom Academy
                        </strong>

                        <span>
                            Admin Panel
                        </span>

                    </div>

                </div>


                <!-- ADMIN USER -->
                <div class="topbar-user">

                    @{
                        var adminName = ViewBag.AdminName?.ToString() ?? "Admin";

                        var adminInitial =
                            !string.IsNullOrWhiteSpace(adminName)
                                ? adminName.Substring(0, 1).ToUpper()
                                : "A";
                    }

                    <div class="topbar-avatar">
                        @adminInitial
                    </div>

                    <div>

                        <strong>
                            @adminName
                        </strong>

                        <small>
                            Super Admin
                        </small>

                    </div>

                </div>


            </div>


            <!-- PAGE CONTENT -->
@RenderBody()


<!-- ===================================================== -->
<!-- ADMIN FOOTER -->
<!-- ===================================================== -->

<footer class="admin-footer">

    <div class="admin-footer-inner">

        <!-- LEFT -->
        <div class="admin-footer-brand">

            <div class="admin-footer-logo">
                ✿
            </div>

            <div>
                <strong>FirstBloom Academy</strong>

                <span>
                    Admin Panel
                </span>
            </div>

        </div>


        <!-- MAIN LINKS -->
        <nav class="admin-footer-links">

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>

            <a asp-area="Admin"
               asp-controller="Admissions"
               asp-action="Index">
                Admissions
            </a>

            <a asp-area="Admin"
               asp-controller="Students"
               asp-action="Index">
                Students
            </a>

            <a asp-area="Admin"
               asp-controller="Programs"
               asp-action="Index">
                Programs
            </a>

            <a asp-area="Admin"
               asp-controller="Reports"
               asp-action="Index">
                Reports
            </a>

            <a asp-area="Admin"
               asp-controller="Settings"
               asp-action="Index">
                Settings
            </a>

        </nav>


        <!-- COPYRIGHT -->
        <div class="admin-footer-bottom">

            <span>
                © @DateTime.Now.Year FirstBloom Academy
            </span>

            <span class="admin-footer-divider">|</span>

            <span>
                Admin Panel
            </span>

        </div>

    </div>

</footer>


        </main>

    </div>


    <!-- ===================================================== -->
    <!-- JAVASCRIPT -->
    <!-- ===================================================== -->

   <script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- ADMIN SIDEBAR TOGGLE -->
<script src="~/js/admin-layout.js"
        asp-append-version="true"></script>


<!-- PAGE-SPECIFIC SCRIPTS -->
@RenderSection("Scripts", required: false)

</body>

</html>