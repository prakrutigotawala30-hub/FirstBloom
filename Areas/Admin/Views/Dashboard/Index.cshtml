@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // =========================================================
    // DATABASE DATA
    // =========================================================

    int totalAdmissions = ViewBag.TotalAdmissions ?? 0;
    int totalStudents = ViewBag.TotalStudents ?? 0;
    int totalPrograms = ViewBag.TotalPrograms ?? 0;
    int totalEnquiries = ViewBag.TotalEnquiries ?? 0;

    // Chart data coming from Controller
    var admissionLabels = ViewBag.AdmissionLabels as string[]
                          ?? new string[]
                          {
                              "Jan", "Feb", "Mar", "Apr",
                              "May", "Jun", "Jul", "Aug",
                              "Sep", "Oct", "Nov", "Dec"
                          };

    var admissionData = ViewBag.AdmissionData as int[]
                        ?? new int[12];

    var enquiryData = ViewBag.EnquiryData as int[]
                      ?? new int[12];
}


<div class="admin-dashboard">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="dashboard-header">

        <div>

            <span class="dashboard-label">
                ADMINISTRATION
            </span>

            <h1>
                Welcome back, @ViewBag.AdminName! 👋
            </h1>

            <p>
                Here's what's happening at FirstBloom Academy today.
            </p>

        </div>


@*         <div class="admin-profile">

    <div class="admin-avatar">
        @{
            var adminName = ViewBag.AdminName ?? "Admin";

            var adminInitial =
                !string.IsNullOrWhiteSpace(adminName.ToString())
                    ? adminName.ToString()
                        .Substring(0, 1)
                        .ToUpper()
                    : "A";
        }

        @adminInitial
    </div>

    <div>

        <strong>
            @adminName
        </strong>

        <small>
            Super Admin
        </small>

    </div>

</div> *@

    </div>



    <!-- =========================================================
         STAT CARDS
         ========================================================= -->

    <div class="dashboard-stats">


        <!-- =====================================================
             TOTAL ADMISSIONS
             ===================================================== -->

        <div class="stat-card">

            <div class="stat-icon purple">

                <i class="fa-solid fa-user-plus"></i>

            </div>

            <div class="stat-content">

                <span>
                    Total Admissions
                </span>

                <h2>
                    @totalAdmissions
                </h2>

                <small class="positive">

                    <i class="fa-solid fa-database"></i>

                    From Database

                </small>

            </div>

        </div>



        <!-- =====================================================
             TOTAL STUDENTS
             ===================================================== -->

        <div class="stat-card">

            <div class="stat-icon blue">

                <i class="fa-solid fa-users"></i>

            </div>

            <div class="stat-content">

                <span>
                    Total Students
                </span>

                <h2>
                    @totalStudents
                </h2>

                <small class="positive">

                    <i class="fa-solid fa-database"></i>

                    From Database

                </small>

            </div>

        </div>



        <!-- =====================================================
             TOTAL PROGRAMS
             ===================================================== -->

        <div class="stat-card">

            <div class="stat-icon pink">

                <i class="fa-solid fa-graduation-cap"></i>

            </div>

            <div class="stat-content">

                <span>
                    Total Programs
                </span>

                <h2>
                    @totalPrograms
                </h2>

                <small class="positive">

                    <i class="fa-solid fa-database"></i>

                    From Database

                </small>

            </div>

        </div>



        <!-- =====================================================
             TOTAL ENQUIRIES
             ===================================================== -->

        <div class="stat-card">

            <div class="stat-icon orange">

                <i class="fa-solid fa-envelope"></i>

            </div>

            <div class="stat-content">

                <span>
                    Total Enquiries
                </span>

                <h2>
                    @totalEnquiries
                </h2>

                <small class="positive">

                    <i class="fa-solid fa-database"></i>

                    From Database

                </small>

            </div>

        </div>

    </div>



    <!-- =========================================================
         MAIN DASHBOARD GRID
         ========================================================= -->

    <div class="dashboard-grid">


        <!-- =====================================================
             ADMISSIONS CHART
             ===================================================== -->

        <div class="dashboard-card admissions-card">

            <div class="card-header">

                <div>

                    <h3>
                        Admissions Overview
                    </h3>

                    <p>
                        Admission and enquiry statistics
                    </p>

                </div>


                <div class="chart-info">

                    <span>
                        <i class="fa-solid fa-circle"></i>
                        Admissions
                    </span>

                    <span>
                        <i class="fa-solid fa-circle"></i>
                        Enquiries
                    </span>

                </div>

            </div>


            <div class="chart-container">

                <canvas id="admissionChart"></canvas>

            </div>

        </div>



        <!-- =====================================================
             RECENT ENQUIRIES
             ===================================================== -->

        <div class="dashboard-card enquiries-card">

            <div class="card-header">

                <div>

                    <h3>
                        Recent Enquiries
                    </h3>

                    <p>
                        Latest parent enquiries
                    </p>

                </div>


                <a asp-area="Admin"
   asp-controller="ContactMessages"
   asp-action="Index"
   class="view-all">

    View All

    <i class="fa-solid fa-arrow-right"></i>

</a>

            </div>



            <div class="enquiry-list">

                @if (ViewBag.RecentEnquiries != null &&
                     ViewBag.RecentEnquiries.Count > 0)
                {

                    foreach (var enquiry in ViewBag.RecentEnquiries)
                    {

                        <div class="enquiry-item">

                            <div class="enquiry-avatar">

                                @enquiry.Initials

                            </div>


                            <div class="enquiry-info">

                                <strong>
                                    @enquiry.Name
                                </strong>

                                <span>
                                    @enquiry.Subject
                                </span>

                            </div>


                            <small>

                                @enquiry.Date

                            </small>

                        </div>

                    }

                }
                else
                {

                    <div class="empty-dashboard">

                        <i class="fa-regular fa-envelope-open"></i>

                        <span>
                            No enquiries found
                        </span>

                    </div>

                }

            </div>

        </div>

    </div>



    <!-- =========================================================
         BOTTOM DASHBOARD
         ========================================================= -->

    <div class="dashboard-bottom">


        <!-- =====================================================
             QUICK ACTIONS
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <h3>
                        Quick Actions
                    </h3>

                    <p>
                        Frequently used actions
                    </p>

                </div>

            </div>


            <div class="quick-actions">


                <!-- Admissions -->

                <a asp-area="Admin"
                   asp-controller="Admissions"
                   asp-action="Index"
                   class="quick-action">

                    <span>

                        <i class="fa-solid fa-user-plus"></i>

                    </span>

                    <strong>
                        Admissions
                    </strong>

                </a>



                <!-- Students -->

                <a asp-area="Admin"
                   asp-controller="Students"
                   asp-action="Index"
                   class="quick-action">

                    <span>

                        <i class="fa-solid fa-user"></i>

                    </span>

                    <strong>
                        Students
                    </strong>

                </a>



                <!-- Programs -->

                <a asp-area="Admin"
                   asp-controller="Programs"
                   asp-action="Index"
                   class="quick-action">

                    <span>

                        <i class="fa-solid fa-graduation-cap"></i>

                    </span>

                    <strong>
                        Programs
                    </strong>

                </a>



                <!-- Notices -->

                <a asp-area="Admin"
                   asp-controller="Notice"
                   asp-action="Index"
                   class="quick-action">

                    <span>

                        <i class="fa-solid fa-bullhorn"></i>

                    </span>

                    <strong>
                        Manage Notices
                    </strong>

                </a>

            </div>

        </div>



        <!-- =====================================================
             IMPORTANT REMINDERS
             ===================================================== -->

        <div class="dashboard-card reminders-card">

            <div class="card-header">

                <div>

                    <h3>
                        Important Reminders
                    </h3>

                    <p>
                        Things that need your attention
                    </p>

                </div>

            </div>


            <div class="reminder-list">


                <!-- Pending Enquiries -->

                <div class="reminder-item">

                    <span class="reminder-dot yellow"></span>

                    <div>

                        <strong>
                            @totalEnquiries Enquiries
                        </strong>

                        <small>
                            Total parent enquiries
                        </small>

                    </div>

                </div>



                <!-- Programs -->

                <div class="reminder-item">

                    <span class="reminder-dot green"></span>

                    <div>

                        <strong>
                            @totalPrograms Programs
                        </strong>

                        <small>
                            Active programs available
                        </small>

                    </div>

                </div>



                <!-- Students -->

                <div class="reminder-item">

                    <span class="reminder-dot pink"></span>

                    <div>

                        <strong>
                            @totalStudents Students
                        </strong>

                        <small>
                            Registered students
                        </small>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



<!-- =========================================================
     CHART.JS
     ========================================================= -->

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const chartElement =
                document.getElementById("admissionChart");


            if (!chartElement) {
                return;
            }


            // =====================================================
            // DATABASE DATA FROM ASP.NET
            // =====================================================

            const labels =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(admissionLabels));


            const admissionData =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(admissionData));


            const enquiryData =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(enquiryData));


            // =====================================================
            // CREATE CHART
            // =====================================================

            new Chart(chartElement, {

                type: "line",

                data: {

                    labels: labels,

                    datasets: [

                        {
                            label: "Admissions",

                            data: admissionData,

                            borderWidth: 3,

                            tension: 0.4,

                            fill: false,

                            pointRadius: 4,

                            pointHoverRadius: 6
                        },


                        {
                            label: "Enquiries",

                            data: enquiryData,

                            borderWidth: 2,

                            tension: 0.4,

                            fill: false,

                            pointRadius: 3,

                            pointHoverRadius: 5
                        }

                    ]

                },


                options: {

                    responsive: true,

                    maintainAspectRatio: false,


                    interaction: {

                        mode: "index",

                        intersect: false

                    },


                    plugins: {

                        legend: {

                            display: false

                        },

                        tooltip: {

                            enabled: true

                        }

                    },


                    scales: {

                        x: {

                            grid: {

                                display: false

                            }

                        },


                        y: {

                            beginAtZero: true,

                            ticks: {

                                precision: 0,

                                stepSize: 1

                            }

                        }

                    }

                }

            });

        });

    </script>

}