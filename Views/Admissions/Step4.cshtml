@model FirstBloom.ViewModels.AdmissionStep4ViewModel

@{
    ViewData["Title"] = "Admission - Step 4";

var programs =
    ViewBag.Programs as IEnumerable<FirstBloom.Models.Programs>
    ?? Enumerable.Empty<FirstBloom.Models.Programs>();


}

<link rel="stylesheet"
      href="~/css/Admissions/admission-steps.css"
      asp-append-version="true" />

<div class="admission-step-page">

    ```
    <div class="admission-topbar">

        <a asp-controller="Admissions"
           asp-action="Index"
           class="back-admissions">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Admissions

        </a>

    </div>


    <!-- =========================================================
     PROGRESS
     ========================================================= -->

    <div class="admission-progress-wrapper">

        <div class="progress-title">
            Step 4 of 6
        </div>


        <div class="admission-progress">

            <div class="progress-line"></div>


            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Child</span>

            </div>


            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Parents</span>

            </div>


            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Address</span>

            </div>


            <div class="progress-step active">

                <div class="step-circle">
                    4
                </div>

                <span>Program</span>

            </div>


            <div class="progress-step">

                <div class="step-circle">
                    5
                </div>

                <span>Documents</span>

            </div>


            <div class="progress-step">

                <div class="step-circle">
                    6
                </div>

                <span>Declaration</span>

            </div>

        </div>

    </div>


    <!-- =========================================================
     CONTENT
     ========================================================= -->

    <div class="admission-content">


        <!-- =====================================================
         ILLUSTRATION
         ===================================================== -->

        <div class="admission-illustration">

            <div class="illustration-shape shape-one"></div>

            <div class="illustration-shape shape-two"></div>


            <div class="clipboard">

                <div class="clipboard-top"></div>


                <div class="clipboard-paper">

                    <div class="paper-row">

                        <div class="paper-icon">

                            <i class="fa-solid fa-graduation-cap"></i>

                        </div>


                        <div class="paper-lines">

                            <span></span>
                            <span></span>

                        </div>

                    </div>


                    <div class="paper-row">

                        <div class="paper-icon check">

                            <i class="fa-solid fa-check"></i>

                        </div>


                        <div class="paper-lines">

                            <span></span>
                            <span></span>

                        </div>

                    </div>


                    <div class="paper-line-long"></div>

                    <div class="paper-line-long"></div>

                    <div class="paper-line-short"></div>

                </div>

            </div>


            <div class="decor-star star-one">
                ✦
            </div>

            <div class="decor-star star-two">
                ✦
            </div>

            <div class="decor-star star-three">
                ✦
            </div>

        </div>


        <!-- =====================================================
         FORM
         ===================================================== -->

        <div class="admission-form-section">

            <div class="form-heading">

                <div class="step-label">
                    STEP 04 OF 06
                </div>


                <h1>
                    Program Selection
                </h1>


                <p>
                    Select the program for your child.
                    Academic year and start date are provided
                    by FirstBloom Academy.
                </p>

            </div>


            <form asp-controller="Admissions"
                  asp-action="Step4"
                  method="post"
                  class="admission-form">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- =================================================
                 PROGRAM
                 ================================================= -->

                <div class="form-field">

                    <label asp-for="Program">
                        Program
                    </label>


                    <div class="select-wrapper">

                        <select asp-for="Program"
                                class="admission-input"
                                id="programSelect">

                            <option value="">
                                Select program
                            </option>


                            @foreach (var program in programs)
                            {
                                <option value="@program.ProgramName"
                                        data-start-date="@program.StartDate.ToString("yyyy-MM-dd")"
                                        selected="@(Model.Program == program.ProgramName)">

                                    @program.ProgramName

                                </option>
                            }

                        </select>


                        <i class="fa-solid fa-chevron-down"></i>

                    </div>


                    <span asp-validation-for="Program"
                          class="field-error">
                    </span>

                </div>


                <!-- =================================================
                 ACADEMIC YEAR
                 ================================================= -->

                <div class="form-field">

                    <label asp-for="AcademicYear">
                        Academic Year
                    </label>


                    <input asp-for="AcademicYear"
                           id="academicYear"
                           class="admission-input"
                           readonly />


                    <small class="field-help">
                        Academic year is automatically assigned
                        by the academy.
                    </small>


                    <span asp-validation-for="AcademicYear"
                          class="field-error">
                    </span>

                </div>


                <!-- =================================================
                 START DATE
                 ================================================= -->

                <div class="form-field">

                    <label asp-for="PreferredStartDate">
                        Program Start Date
                    </label>


                    <input asp-for="PreferredStartDate"
                           id="startDate"
                           type="date"
                           class="admission-input"
                           readonly />


                    <small class="field-help">
                        Start date is set by the academy for
                        the selected program.
                    </small>


                    <span asp-validation-for="PreferredStartDate"
                          class="field-error">
                    </span>

                </div>


                <!-- =================================================
                 ACTIONS
                 ================================================= -->

                <div class="form-actions">

                    <a asp-controller="Admissions"
                       asp-action="Step3"
                       class="cancel-btn">

                        <i class="fa-solid fa-arrow-left"></i>

                        Previous Step

                    </a>


                    <button type="submit"
                            class="next-btn">

                        <span>
                            Next Step
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const programSelect =
                    document.getElementById(
                        "programSelect"
                    );

                const startDate =
                    document.getElementById(
                        "startDate"
                    );


                function updateStartDate() {

                    const selectedOption =
                        programSelect.options[
                        programSelect.selectedIndex
                        ];


                    if (!selectedOption ||
                        !selectedOption.value) {

                        startDate.value = "";

                        return;
                    }


                    const programStartDate =
                        selectedOption.getAttribute(
                            "data-start-date"
                        );


                    startDate.value =
                        programStartDate || "";
                }


                programSelect.addEventListener(
                    "change",
                    updateStartDate
                );


                // Load date automatically
                // if a program was already selected.

                updateStartDate();

            });

    </script>

}
