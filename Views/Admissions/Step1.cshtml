@model FirstBloom.ViewModels.AdmissionStep1ViewModel

@{
    ViewData["Title"] = "Admission - Step 1";
}

<link rel="stylesheet"
      href="~/css/Admissions/admission-steps.css"
      asp-append-version="true" />

<div class="admission-step-page">

    <!-- TOP BAR -->
    <div class="admission-topbar">
        <a asp-controller="Admissions"
           asp-action="Index"
           class="back-admissions">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Admissions

        </a>
    </div>


    <!-- PROGRESS -->
    <div class="admission-progress-wrapper">

        <div class="progress-title">
            Step 1 of 6
        </div>

        <div class="admission-progress">

            <div class="progress-line"></div>

            <div class="progress-step active">
                <div class="step-circle">1</div>
                <span>Child</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">2</div>
                <span>Parents</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">3</div>
                <span>Address</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">4</div>
                <span>Program</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">5</div>
                <span>Documents</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">6</div>
                <span>Declaration</span>
            </div>

        </div>
    </div>


    <!-- CONTENT -->
    <div class="admission-content">

        <!-- LEFT -->
        <div class="admission-illustration">

            <div class="illustration-shape shape-one"></div>
            <div class="illustration-shape shape-two"></div>

            <div class="clipboard">

                <div class="clipboard-top"></div>

                <div class="clipboard-paper">

                    <div class="paper-row">
                        <div class="paper-icon">
                            <i class="fa-regular fa-user"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-row">
                        <div class="paper-icon check">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-line-long"></div>
                    <div class="paper-line-long"></div>
                    <div class="paper-line-short"></div>

                </div>

            </div>

            <div class="plant">
                <div class="plant-leaf leaf-one"></div>
                <div class="plant-leaf leaf-two"></div>
                <div class="plant-leaf leaf-three"></div>
                <div class="plant-leaf leaf-four"></div>
                <div class="plant-pot"></div>
            </div>

            <div class="decor-star star-one">✦</div>
            <div class="decor-star star-two">✦</div>
            <div class="decor-star star-three">✦</div>

        </div>


        <!-- RIGHT FORM -->
        <div class="admission-form-section">

            <div class="form-heading">

                <div class="step-label">
                    STEP 01 OF 06
                </div>

                <h1>
                    Child Information
                </h1>

                <p>
                    Tell us about the child applying to FirstBloom Academy.
                </p>

            </div>


            <form asp-controller="Admissions"
                  asp-action="Step1"
                  method="post"
                  class="admission-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- FIRST NAME -->
                <div class="form-field">

                    <label asp-for="ChildFirstName">
                        Child First Name
                    </label>

                    <input asp-for="ChildFirstName"
                           class="admission-input"
                           placeholder="Enter child's first name"
                           autocomplete="given-name" />

                    <span asp-validation-for="ChildFirstName"
                          class="field-error">
                    </span>

                </div>


                <!-- LAST NAME -->
                <div class="form-field">

                    <label asp-for="ChildLastName">
                        Child Last Name
                    </label>

                    <input asp-for="ChildLastName"
                           class="admission-input"
                           placeholder="Enter child's last name"
                           autocomplete="family-name" />

                    <span asp-validation-for="ChildLastName"
                          class="field-error">
                    </span>

                </div>


                <!-- DATE OF BIRTH -->
                <div class="form-field">

                    <label asp-for="DateOfBirth">
                        Date of Birth
                    </label>

                    <input asp-for="DateOfBirth"
                           type="date"
                           class="admission-input" />

                    <span asp-validation-for="DateOfBirth"
                          class="field-error">
                    </span>

                </div>


                <!-- GENDER -->
                <div class="form-field">

                    <label asp-for="Gender">
                        Gender
                    </label>

                    <div class="select-wrapper">

                        <select asp-for="Gender"
                                class="admission-input">

                            <option value="">
                                Select gender
                            </option>

                            <option value="Male">
                                Male
                            </option>

                            <option value="Female">
                                Female
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                        <i class="fa-solid fa-chevron-down"></i>

                    </div>

                    <span asp-validation-for="Gender"
                          class="field-error">
                    </span>

                </div>


                <!-- BLOOD GROUP -->
                <div class="form-field">

                    <label asp-for="BloodGroup">
                        Blood Group
                    </label>

                    <div class="select-wrapper">

                        <select asp-for="BloodGroup"
                                class="admission-input">

                            <option value="">
                                Select blood group
                            </option>

                            <option value="A+">A+</option>
                            <option value="A-">A-</option>
                            <option value="B+">B+</option>
                            <option value="B-">B-</option>
                            <option value="AB+">AB+</option>
                            <option value="AB-">AB-</option>
                            <option value="O+">O+</option>
                            <option value="O-">O-</option>

                        </select>

                        <i class="fa-solid fa-chevron-down"></i>

                    </div>

                    <span asp-validation-for="BloodGroup"
                          class="field-error">
                    </span>

                </div>


                <!-- PREVIOUS SCHOOL -->
                <div class="form-field">

                    <label asp-for="PreviousSchool">
                        Previous School
                    </label>

                    <input asp-for="PreviousSchool"
                           class="admission-input"
                           placeholder="Enter previous school name (if any)" />

                    <span asp-validation-for="PreviousSchool"
                          class="field-error">
                    </span>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-controller="Admissions"
                       asp-action="Index"
                       class="cancel-btn">

                        Cancel

                    </a>

                    <button type="submit"
                            class="next-btn">

                        <span>Next Step</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}