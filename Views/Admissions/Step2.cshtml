@model FirstBloom.ViewModels.AdmissionStep2ViewModel

@{
    ViewData["Title"] = "Admission - Step 2";
}

<link rel="stylesheet"
      href="~/css/Admissions/admission-steps.css"
      asp-append-version="true" />

<div class="admission-step-page">

    <!-- TOP BAR -->
    <div class="admission-topbar">

        <a asp-controller="Admissions"
           asp-action="Index"
           class="back-admissions">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Admissions

        </a>

    </div>


    <!-- PROGRESS -->
    <div class="admission-progress-wrapper">

        <div class="progress-title">
            Step 2 of 6
        </div>

        <div class="admission-progress">

            <div class="progress-line"></div>

            <div class="progress-step completed">
                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span>Child</span>
            </div>

            <div class="progress-step active">
                <div class="step-circle">2</div>
                <span>Parents</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">3</div>
                <span>Address</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">4</div>
                <span>Program</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">5</div>
                <span>Documents</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">6</div>
                <span>Declaration</span>
            </div>

        </div>

    </div>


    <!-- CONTENT -->
    <div class="admission-content">

        <!-- LEFT -->
        <div class="admission-illustration">

            <div class="illustration-shape shape-one"></div>
            <div class="illustration-shape shape-two"></div>

            <div class="clipboard">

                <div class="clipboard-top"></div>

                <div class="clipboard-paper">

                    <div class="paper-row">
                        <div class="paper-icon">
                            <i class="fa-solid fa-user-group"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-row">
                        <div class="paper-icon check">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-line-long"></div>
                    <div class="paper-line-long"></div>
                    <div class="paper-line-short"></div>

                </div>

            </div>

            <div class="decor-star star-one">✦</div>
            <div class="decor-star star-two">✦</div>
            <div class="decor-star star-three">✦</div>

        </div>


        <!-- FORM -->
        <div class="admission-form-section">

            <div class="form-heading">

                <div class="step-label">
                    STEP 02 OF 06
                </div>

                <h1>
                    Parent Information
                </h1>

                <p>
                    Please provide the details of the child's parents or guardians.
                </p>

            </div>


            <form asp-controller="Admissions"
                  asp-action="Step2"
                  method="post"
                  class="admission-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- FATHER NAME -->
                <div class="form-field">

                    <label asp-for="FatherName">
                        Father's Name
                    </label>

                    <input asp-for="FatherName"
                           class="admission-input"
                           placeholder="Enter father's full name"
                           autocomplete="name" />

                    <span asp-validation-for="FatherName"
                          class="field-error">
                    </span>

                </div>


                <!-- FATHER OCCUPATION -->
                <div class="form-field">

                    <label asp-for="FatherOccupation">
                        Father's Occupation
                    </label>

                    <input asp-for="FatherOccupation"
                           class="admission-input"
                           placeholder="Enter father's occupation" />

                    <span asp-validation-for="FatherOccupation"
                          class="field-error">
                    </span>

                </div>


                <!-- FATHER PHONE -->
                <div class="form-field">

                    <label asp-for="FatherPhone">
                        Father's Phone
                    </label>

                    <input asp-for="FatherPhone"
                           type="tel"
                           class="admission-input"
                           placeholder="Enter father's phone number"
                           autocomplete="tel" />

                    <span asp-validation-for="FatherPhone"
                          class="field-error">
                    </span>

                </div>


                <!-- MOTHER NAME -->
                <div class="form-field">

                    <label asp-for="MotherName">
                        Mother's Name
                    </label>

                    <input asp-for="MotherName"
                           class="admission-input"
                           placeholder="Enter mother's full name"
                           autocomplete="name" />

                    <span asp-validation-for="MotherName"
                          class="field-error">
                    </span>

                </div>


                <!-- MOTHER OCCUPATION -->
                <div class="form-field">

                    <label asp-for="MotherOccupation">
                        Mother's Occupation
                    </label>

                    <input asp-for="MotherOccupation"
                           class="admission-input"
                           placeholder="Enter mother's occupation" />

                    <span asp-validation-for="MotherOccupation"
                          class="field-error">
                    </span>

                </div>


                <!-- MOTHER PHONE -->
                <div class="form-field">

                    <label asp-for="MotherPhone">
                        Mother's Phone
                    </label>

                    <input asp-for="MotherPhone"
                           type="tel"
                           class="admission-input"
                           placeholder="Enter mother's phone number"
                           autocomplete="tel" />

                    <span asp-validation-for="MotherPhone"
                          class="field-error">
                    </span>

                </div>


                <!-- PARENT EMAIL -->
                <div class="form-field">

                    <label asp-for="ParentEmail">
                        Parent Email
                    </label>

                    <input asp-for="ParentEmail"
                           type="email"
                           class="admission-input"
                           placeholder="Enter parent email address"
                           autocomplete="email" />

                    <span asp-validation-for="ParentEmail"
                          class="field-error">
                    </span>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-controller="Admissions"
                       asp-action="Step1"
                       class="cancel-btn">

                        <i class="fa-solid fa-arrow-left"></i>
                        Previous Step

                    </a>

                    <button type="submit"
                            class="next-btn">

                        <span>Next Step</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}