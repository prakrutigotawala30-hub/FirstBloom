@model FirstBloom.ViewModels.AdmissionStep3ViewModel

@{
    ViewData["Title"] = "Admission - Step 3";
}

<link rel="stylesheet"
      href="~/css/Admissions/admission-steps.css"
      asp-append-version="true" />

<div class="admission-step-page">

    <div class="admission-topbar">

        <a asp-controller="Admissions"
           asp-action="Index"
           class="back-admissions">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Admissions

        </a>

    </div>


    <div class="admission-progress-wrapper">

        <div class="progress-title">
            Step 3 of 6
        </div>

        <div class="admission-progress">

            <div class="progress-line"></div>

            <div class="progress-step completed">
                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span>Child</span>
            </div>

            <div class="progress-step completed">
                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>
                <span>Parents</span>
            </div>

            <div class="progress-step active">
                <div class="step-circle">3</div>
                <span>Address</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">4</div>
                <span>Program</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">5</div>
                <span>Documents</span>
            </div>

            <div class="progress-step">
                <div class="step-circle">6</div>
                <span>Declaration</span>
            </div>

        </div>

    </div>


    <div class="admission-content">

        <div class="admission-illustration">

            <div class="illustration-shape shape-one"></div>
            <div class="illustration-shape shape-two"></div>

            <div class="clipboard">

                <div class="clipboard-top"></div>

                <div class="clipboard-paper">

                    <div class="paper-row">
                        <div class="paper-icon">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-row">
                        <div class="paper-icon check">
                            <i class="fa-solid fa-check"></i>
                        </div>

                        <div class="paper-lines">
                            <span></span>
                            <span></span>
                        </div>
                    </div>

                    <div class="paper-line-long"></div>
                    <div class="paper-line-long"></div>
                    <div class="paper-line-short"></div>

                </div>

            </div>

            <div class="decor-star star-one">✦</div>
            <div class="decor-star star-two">✦</div>
            <div class="decor-star star-three">✦</div>

        </div>


        <div class="admission-form-section">

            <div class="form-heading">

                <div class="step-label">
                    STEP 03 OF 06
                </div>

                <h1>
                    Address Information
                </h1>

                <p>
                    Please provide the current residential address.
                </p>

            </div>


            <form asp-controller="Admissions"
                  asp-action="Step3"
                  method="post"
                  class="admission-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- ADDRESS -->
                <div class="form-field">

                    <label asp-for="Address">
                        Full Address
                    </label>

                    <textarea asp-for="Address"
                              class="admission-input"
                              rows="4"
                              placeholder="Enter complete residential address"></textarea>

                    <span asp-validation-for="Address"
                          class="field-error">
                    </span>

                </div>


                <!-- CITY -->
                <div class="form-field">

                    <label asp-for="City">
                        City
                    </label>

                    <input asp-for="City"
                           class="admission-input"
                           placeholder="Enter city" />

                    <span asp-validation-for="City"
                          class="field-error">
                    </span>

                </div>


                <!-- STATE -->
                <div class="form-field">

                    <label asp-for="State">
                        State
                    </label>

                    <input asp-for="State"
                           class="admission-input"
                           placeholder="Enter state" />

                    <span asp-validation-for="State"
                          class="field-error">
                    </span>

                </div>


                <!-- PINCODE -->
                <div class="form-field">

                    <label asp-for="Pincode">
                        Pincode
                    </label>

                    <input asp-for="Pincode"
                           class="admission-input"
                           placeholder="Enter pincode"
                           maxlength="10"
                           inputmode="numeric" />

                    <span asp-validation-for="Pincode"
                          class="field-error">
                    </span>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">

                    <a asp-controller="Admissions"
                       asp-action="Step2"
                       class="cancel-btn">

                        <i class="fa-solid fa-arrow-left"></i>
                        Previous Step

                    </a>

                    <button type="submit"
                            class="next-btn">

                        <span>Next Step</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}