@model FirstBloom.ViewModels.AdmissionStep5ViewModel

@{
    ViewData["Title"] = "Admission - Step 5";
}

<link rel="stylesheet"
      href="~/css/Admissions/admission-steps.css"
      asp-append-version="true" />

<div class="admission-step-page">

    <!-- TOP BAR -->
    <div class="admission-topbar">

        <a asp-controller="Admissions"
           asp-action="Index"
           class="back-admissions">

            <i class="fa-solid fa-arrow-left"></i>
            Back to Admissions

        </a>

    </div>


    <!-- PROGRESS -->
    <div class="admission-progress-wrapper">

        <div class="progress-title">
            Step 5 of 6
        </div>

        <div class="admission-progress">

            <div class="progress-line"></div>


            <!-- STEP 1 -->
            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Inquiry</span>

            </div>


            <!-- STEP 2 -->
            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Tour</span>

            </div>


            <!-- STEP 3 -->
            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Application</span>

            </div>


            <!-- STEP 4 -->
            <div class="progress-step completed">

                <div class="step-circle">
                    <i class="fa-solid fa-check"></i>
                </div>

                <span>Assessment</span>

            </div>


            <!-- STEP 5 -->
            <div class="progress-step active">

                <div class="step-circle">
                    5
                </div>

                <span>Confirmation</span>

            </div>


            <!-- STEP 6 -->
            <div class="progress-step">

                <div class="step-circle">
                    6
                </div>

                <span>Welcome</span>

            </div>

        </div>

    </div>


    <!-- CONTENT -->
    <div class="admission-content">


        <!-- LEFT ILLUSTRATION -->
        <div class="admission-illustration">

            <div class="illustration-shape shape-one"></div>
            <div class="illustration-shape shape-two"></div>


            <div class="documents-illustration">


                <!-- Main document -->
                <div class="document-main">

                    <div class="document-header">

                        <i class="fa-solid fa-file-lines"></i>

                    </div>

                    <div class="document-lines">

                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>

                    </div>

                    <div class="document-check">

                        <i class="fa-solid fa-check"></i>

                    </div>

                </div>


                <!-- Small document -->
                <div class="document-small">

                    <i class="fa-solid fa-image"></i>

                </div>


                <!-- Upload icon -->
                <div class="upload-icon">

                    <i class="fa-solid fa-arrow-up-from-bracket"></i>

                </div>

            </div>


            <!-- Decorations -->

            <div class="decor-star star-one">
                ✦
            </div>

            <div class="decor-star star-two">
                ✦
            </div>

            <div class="decor-star star-three">
                ✦
            </div>


            <div class="decor-heart heart-one">
                ♥
            </div>

            <div class="decor-heart heart-two">
                ♥
            </div>

        </div>


        <!-- FORM -->
        <div class="admission-form-section">


            <div class="form-heading">

                <div class="step-label">
                    STEP 05 OF 06
                </div>

                <h1>
                    Documents &amp; Verification
                </h1>

                <p>
                    Upload the required documents to complete your application.
                </p>

            </div>


            <form asp-controller="Admissions"
                  asp-action="Step5"
                  method="post"
                  enctype="multipart/form-data"
                  class="admission-form">

                @Html.AntiForgeryToken()


                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- DOCUMENT SECTION -->
                <div class="documents-section">


                    <div class="documents-section-heading">

                        <div class="documents-section-icon">

                            <i class="fa-solid fa-file-circle-check"></i>

                        </div>

                        <div>

                            <h3>
                                Required Documents
                            </h3>

                            <p>
                                Please upload clear and readable documents
                            </p>

                        </div>

                    </div>


                    <!-- BIRTH CERTIFICATE -->
                    <div class="document-upload-field">

                        <div class="document-upload-info">

                            <div class="document-upload-icon birth-icon">

                                <i class="fa-solid fa-certificate"></i>

                            </div>

                            <div>

                                <label asp-for="BirthCertificate">

                                    Birth Certificate

                                </label>

                                <p>
                                    PDF, JPG or PNG
                                </p>

                            </div>

                        </div>


                        <div class="file-input-wrapper">

                            <input asp-for="BirthCertificate"
                                   type="file"
                                   accept=".pdf,.jpg,.jpeg,.png"
                                   class="document-file-input" />

                            <label asp-for="BirthCertificate"
                                   class="choose-file-btn">

                                <i class="fa-solid fa-upload"></i>

                                Choose File

                            </label>

                        </div>

                    </div>


                    <!-- CHILD PHOTO -->
                    <div class="document-upload-field">

                        <div class="document-upload-info">

                            <div class="document-upload-icon photo-icon">

                                <i class="fa-solid fa-camera"></i>

                            </div>

                            <div>

                                <label asp-for="ChildPhoto">

                                    Child Photo

                                </label>

                                <p>
                                    JPG or PNG
                                </p>

                            </div>

                        </div>


                        <div class="file-input-wrapper">

                            <input asp-for="ChildPhoto"
                                   type="file"
                                   accept=".jpg,.jpeg,.png"
                                   class="document-file-input" />

                            <label asp-for="ChildPhoto"
                                   class="choose-file-btn">

                                <i class="fa-solid fa-upload"></i>

                                Choose File

                            </label>

                        </div>

                    </div>


                    <!-- ADDRESS PROOF -->
                    <div class="document-upload-field">

                        <div class="document-upload-info">

                            <div class="document-upload-icon address-proof-icon">

                                <i class="fa-solid fa-house"></i>

                            </div>

                            <div>

                                <label asp-for="AddressProof">

                                    Address Proof

                                </label>

                                <p>
                                    PDF, JPG or PNG
                                </p>

                            </div>

                        </div>


                        <div class="file-input-wrapper">

                            <input asp-for="AddressProof"
                                   type="file"
                                   accept=".pdf,.jpg,.jpeg,.png"
                                   class="document-file-input" />

                            <label asp-for="AddressProof"
                                   class="choose-file-btn">

                                <i class="fa-solid fa-upload"></i>

                                Choose File

                            </label>

                        </div>

                    </div>


                </div>


                <!-- INFORMATION BOX -->
                <div class="upload-note">

                    <div class="upload-note-icon">

                        <i class="fa-solid fa-circle-info"></i>

                    </div>

                    <div>

                        <strong>
                            Document guidelines
                        </strong>

                        <p>
                            Make sure all uploaded documents are clear,
                            readable and not password protected.
                        </p>

                    </div>

                </div>


                <!-- ACTIONS -->
                <div class="form-actions">


                    <a asp-controller="Admissions"
                       asp-action="Step4"
                       class="cancel-btn">

                        <i class="fa-solid fa-arrow-left"></i>

                        Previous Step

                    </a>


                    <button type="submit"
                            class="next-btn">

                        <span>
                            Next Step
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}