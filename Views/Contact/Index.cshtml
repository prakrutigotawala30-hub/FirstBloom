@model FirstBloom.Models.ContactMessage

@{
    ViewData["Title"] = "Contact Us";
}

<link rel="stylesheet"
      href="~/css/contact.css"
      asp-append-version="true" />


<!-- =========================================
     CONTACT HERO
     ========================================= -->

<section class="contact-hero">

    <div class="contact-hero-content">

        <h1>Contact Us</h1>


        <div class="contact-breadcrumb">

            <a asp-controller="Home"
               asp-action="Index">
                Home
            </a>

            <span>›</span>

            <a asp-controller="Contact"
               asp-action="Index">
                Contact
            </a>

        </div>

    </div>

</section>


<!-- =========================================
     CONTACT SECTION
     ========================================= -->

<section class="contact-section">

    <div class="contact-container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="contact-success">

                <i class="bi bi-check-circle-fill"></i>

                <span>
                    @TempData["SuccessMessage"]
                </span>

            </div>
        }


        <div class="contact-grid">


            <!-- =================================
                 LEFT SIDE
                 ================================= -->

            <div class="contact-info">

                <span class="contact-small-title">
                    GET IN TOUCH
                </span>

                <h2>
                    We'd Love to
                    <span>Hear From You</span>
                </h2>

                <p class="contact-intro">

                    We'd love to hear from you!
                    Whether you have questions about our
                    programs, admissions, activities or would
                    simply like to visit our campus, we're here
                    to help.

                </p>


                <!-- ADDRESS -->

                <div class="contact-info-item">

                    <div class="contact-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>

                    <div>

                        <h4>Address</h4>

                        <p>
                            11, FirstBloom Academy<br />
                            Surat - 395007
                        </p>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="contact-info-item">

                    <div class="contact-icon">
                        <i class="bi bi-telephone-fill"></i>
                    </div>

                    <div>

                        <h4>Phone</h4>

                        <p>
                            <a href="tel:+919974034290">
                                +91 99740 34290
                            </a>
                        </p>

                    </div>

                </div>


                <!-- EMAIL -->

                <div class="contact-info-item">

                    <div class="contact-icon">
                        <i class="bi bi-envelope-fill"></i>
                    </div>

                    <div>

                        <h4>Email</h4>

                        <p>
                            <a href="mailto:info@firstbloomacademy.com">
                                info@firstbloomacademy.com
                            </a>
                        </p>

                    </div>

                </div>


                <!-- HOURS -->

                <div class="contact-info-item">

                    <div class="contact-icon">
                        <i class="bi bi-clock-fill"></i>
                    </div>

                    <div>

                        <h4>Hours</h4>

                        <p>
                            Monday - Friday<br />
                            8:00 AM - 5:00 PM
                        </p>

                    </div>

                </div>


                <!-- SOCIAL -->

                <div class="contact-social">

                    <span>Follow Us</span>

                    <div class="contact-social-links">

                        <a href="#">
                            <i class="bi bi-facebook"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-instagram"></i>
                        </a>

                        <a href="#">
                            <i class="bi bi-youtube"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- =================================
                 RIGHT SIDE FORM
                 ================================= -->

            <div class="contact-form-card">

                <div class="contact-form-header">

                    <span>HAVE A QUESTION?</span>

                    <h2>
                        Send Us a Message
                    </h2>

                    <p>
                        Fill out the form below and our
                        team will get back to you soon.
                    </p>

                </div>


                <form asp-controller="Contact"
                      asp-action="Index"
                      method="post"
                      class="contact-form">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger">
                    </div>


                    <!-- NAME -->

                    <div class="form-group">

                        <label asp-for="Name">
                            Your Name
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-person"></i>

                            <input asp-for="Name"
                                   placeholder="Enter your name" />

                        </div>

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-envelope"></i>

                            <input asp-for="Email"
                                   placeholder="Enter your email" />

                        </div>

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PHONE -->

                    <div class="form-group">

                        <label asp-for="Phone">
                            Phone Number
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-telephone"></i>

                            <input asp-for="Phone"
                                   placeholder="Enter your phone number" />

                        </div>

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- SUBJECT -->

                    <div class="form-group">

                        <label asp-for="Subject">
                            Subject
                        </label>

                        <div class="input-wrapper">

                            <i class="bi bi-chat-left-text"></i>

                            <input asp-for="Subject"
                                   placeholder="What can we help you with?" />

                        </div>

                        <span asp-validation-for="Subject"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- MESSAGE -->

                    <div class="form-group">

                        <label asp-for="Message">
                            Message
                        </label>

                        <div class="textarea-wrapper">

                            <i class="bi bi-pencil"></i>

                            <textarea asp-for="Message"
                                      rows="5"
                                      placeholder="Write your message here..."></textarea>

                        </div>

                        <span asp-validation-for="Message"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BUTTON -->

                    <button type="submit"
                            class="contact-submit-btn">

                        Send Message

                        <span>
                            <i class="bi bi-arrow-right"></i>
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

</section>


<!-- =========================================
     MAP
     ========================================= -->

<section class="contact-map-section">

    <div class="contact-container">

        <div class="contact-map-header">

            <span class="contact-small-title">
                FIND US
            </span>

            <h2>
                Visit FirstBloom Academy
            </h2>

        </div>

        <div class="contact-map">

            <iframe src="https://www.google.com/maps?q=21.170240,72.831062&z=13&output=embed"
                    loading="lazy"
                    allowfullscreen>
            </iframe>

        </div>

    </div>

</section>


<!-- =========================================
     CTA
     ========================================= -->

<section class="contact-cta">

    <div class="contact-cta-content">

        <span class="contact-small-title">
            LET'S CONNECT
        </span>

        <h2>
            Have Questions About
            <span>Admissions?</span>
        </h2>

        <p>
            Our friendly team is always happy to help
            you learn more about FirstBloom Academy.
        </p>

        <a href="tel:+919974034290"
           class="contact-cta-btn">

            <i class="bi bi-telephone-fill"></i>

            Call Us Today

        </a>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}