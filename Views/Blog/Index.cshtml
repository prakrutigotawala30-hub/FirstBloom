@model List<FirstBloom.Models.Blog>

@{
    ViewData["Title"] = "Blog";
    var categories = ViewBag.Categories as List<string>;
    var popularPosts = ViewBag.PopularPosts as List<FirstBloom.Models.Blog>;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var search = ViewBag.Search as string;
}

<link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />

<!-- HERO -->
<section class="blog-hero">
    <div class="blog-hero-overlay"></div>
    <div class="blog-hero-content">
        <h1>Our <span>Blog</span></h1>
        <div class="blog-breadcrumb">
            <a href="/">Home</a>
            <span>›</span>
            <a href="/Blog">Blog</a>
        </div>
    </div>
</section>

<!-- MAIN -->
<section class="blog-main-section">
    <div class="blog-main-container">
        <div class="blog-layout">

            <!-- GRID -->
            <div class="blog-grid-area">

                <div class="blog-section-label">OUR ARTICLES</div>
                <h2 class="blog-section-heading">
                    Insights & Tips for <span>Parents and Educators</span>
                </h2>

                @if (!Model.Any())
                {
                    <div class="blog-empty">
                        <p>No blog posts found.</p>
                    </div>
                }
                else
                {
                    <div class="blog-cards-grid">
                        @foreach (var blog in Model)
                        {
                            <div class="blog-card">
                                <div class="blog-card-img">
                                    <img src="@blog.ImageUrl" alt="@blog.Title" />
                                    <span class="blog-cat-badge">@blog.Category</span>
                                </div>
                                <div class="blog-card-body">
                                    <div class="blog-card-meta">
                                        <span>@blog.PublishedDate.ToString("dd MMM yyyy")</span>
                                        <span>@blog.ReadTime</span>
                                    </div>
                                    <h5 class="blog-card-title">@blog.Title</h5>
                                    <p class="blog-card-desc">@blog.ShortDescription</p>
                                    <a href="/Blog/Details/@blog.Id" class="blog-read-more">
                                        Read More →
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- SIDEBAR -->
            <div class="blog-sidebar">

                <!-- SEARCH -->
                <div class="blog-sidebar-box">
                    <form method="get" action="/Blog">
                        <div class="blog-search-box">
                            <input type="text" name="search"
                                   placeholder="Search blogs..."
                                   value="@search" />
                            <button type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </form>
                </div>

                <!-- CATEGORIES -->
                <div class="blog-sidebar-box">
                    <div class="blog-section-label">EXPLORE</div>
                    <h5 class="blog-sidebar-title">Categories</h5>
                    <ul class="blog-cat-list">
                        <li>
                            <a href="/Blog"
                               class="@(selectedCategory == "All" ? "active" : "")">
                                All Categories
                            </a>
                        </li>
                        @if (categories != null)
                        {
                            @foreach (var cat in categories)
                            {
                                <li>
                                    <a href="/Blog?category=@cat"
                                       class="@(selectedCategory == cat ? "active" : "")">
                                        @cat
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>

                <!-- POPULAR POSTS -->
                <div class="blog-sidebar-box">
                    <div class="blog-section-label">TRENDING</div>
                    <h5 class="blog-sidebar-title">Popular Posts</h5>
                    @if (popularPosts != null)
                    {
                        @foreach (var post in popularPosts)
                        {
                            <div class="blog-popular-post">
                                <img src="@post.ImageUrl" alt="@post.Title" />
                                <div>
                                    <a href="/Blog/Details/@post.Id">@post.Title</a>
                                    <span>@post.PublishedDate.ToString("dd MMM yyyy")</span>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- NEED HELP -->
                <div class="blog-sidebar-box blog-need-help">
                    <h5>Need Help?</h5>
                    <p>Our admission team is here to help you.</p>
                    <p><i class="bi bi-telephone"></i> +91 99740 34290</p>
                    <p><i class="bi bi-envelope"></i> info@firstbloomacademy.com</p>
                </div>

            </div>
        </div>
    </div>
</section>