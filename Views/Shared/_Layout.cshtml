<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - FirstBloom Academy
    </title>


    <!-- =====================================================
         BOOTSTRAP
         ===================================================== -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =====================================================
         BOOTSTRAP ICONS
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- =====================================================
         FONT AWESOME
         ==========================x=========================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =====================================================
         ASP.NET GENERATED CSS
         ===================================================== -->

    <link rel="stylesheet"
          href="~/FirstBloom.styles.css"
          asp-append-version="true" />


    <!-- =====================================================
         FIRSTBLOOM CUSTOM CSS
         IMPORTANT: KEEP THIS LAST
         ===================================================== -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

          <link rel="stylesheet"
      href="~/css/notification.css"
      asp-append-version="true" />

</head>


<body>


    <!-- =====================================================
         APPLICATION LAYOUT
         ===================================================== -->

    <div class="fb-layout"
         id="fbLayout">


        <!-- =================================================
             SIDEBAR
             ================================================= -->

        @await Html.PartialAsync("_Sidebar")


        <!-- =================================================
             MAIN SIDE
             ================================================= -->

        <div class="fb-main-wrapper"
             id="fbMainWrapper">


            <!-- =================================================
                 HEADER
                 NO LOGO HERE
                 ================================================= -->

            <header class="fb-header">

                <nav class="fb-navbar">

                    <div class="fb-navbar-container">


                        <!-- SIDEBAR TOGGLE -->

                        <button type="button"
                                class="fb-sidebar-toggle"
                                id="fbSidebarToggle"
                                aria-label="Toggle sidebar"
                                aria-expanded="true">

                            <i class="fa-solid fa-bars"></i>

                        </button>

<!-- =====================================================
     PROGRAM SEARCH
     ===================================================== -->

<div class="search-box" id="programSearchBox">

    <input type="text"
           id="programSearchInput"
           class="search-input"
           placeholder="Search Programs..." />

    <button type="button"
            id="programSearchButton"
            class="search-button">

        <i class="bi bi-search"></i>

    </button>

    <div id="programSearchResults"
         class="program-search-results">
    </div>

</div>


<div class="fb-navbar-right">

    <!-- =====================================================
         STUDENT LOGIN / ACCOUNT
         ===================================================== -->

@if (User.Identity?.IsAuthenticated == true &&
         User.IsInRole("Student"))
{
    <!-- =====================================================
         STUDENT ACCOUNT
         ===================================================== -->

    <a class="fb-navbar-login"
       asp-area=""
       asp-controller="StudentAccount"
       asp-action="Profile">

        <i class="fa-solid fa-user"></i>

        <span>
            My Account
        </span>

    </a>
}
else
{
    <!-- =====================================================
         NOT LOGGED IN
         ===================================================== -->

    <a class="fb-navbar-login"
       asp-area=""
       asp-controller="StudentAccount"
       asp-action="Login">

        <i class="fa-solid fa-right-to-bracket"></i>

        <span>
            Student Login
        </span>

    </a>
}

    <!-- =====================================================
         NOTIFICATION
         ===================================================== -->

    <div class="fb-notification-wrapper"
         id="fbNotificationWrapper">

        <button type="button"
                class="fb-notification-btn"
                id="fbNotificationBtn"
                aria-label="Notifications"
                aria-expanded="false">

            <i class="fa-solid fa-bell"></i>

            <span class="fb-notification-count"
                  id="fbNotificationCount">
                0
            </span>

        </button>

        <div class="fb-notification-dropdown"
             id="fbNotificationDropdown">

            <div class="fb-notification-header">

                <div class="fb-notification-header-left">

                    <div class="fb-notification-header-icon">
                        <i class="fa-solid fa-bell"></i>
                    </div>

                    <div>

                        <h4>
                            Notifications
                        </h4>

                        <small id="fbNotificationSubtitle">
                            Latest notices
                        </small>

                    </div>

                </div>

                <button type="button"
                        class="fb-notification-mark"
                        id="fbMarkAll"
                        title="Mark all notifications as viewed">

                    <i class="fa-solid fa-check-double"></i>

                    <span>
                        Mark viewed
                    </span>

                </button>

            </div>

            <div class="fb-notification-list"
                 id="fbNotificationList">
            </div>

            <div class="fb-notification-footer">

                <a asp-controller="Notice"
                   asp-action="Index"
                   class="fb-notification-view-all">

                    <span>
                        View All Notices
                    </span>

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ADMIN LOGIN
         ===================================================== -->

    <a class="fb-navbar-admin"
       asp-area="Admin"
       asp-controller="Account"
       asp-action="Login">

        <i class="fa-solid fa-user-shield"></i>

        <span>
            Admin
        </span>

    </a>


    <!-- =====================================================
         ENQUIRE BUTTON
         ===================================================== -->

    <a class="fb-navbar-enquire"
       asp-controller="Contact"
       asp-action="Index">

        <i class="fa-solid fa-paper-plane"></i>

        <span>
            Enquire Now
        </span>

    </a>

</div>




                    </div>

                </nav>

            </header>


            <!-- =================================================
                 MAIN PAGE CONTENT
                 ================================================= -->

            <main class="fb-page-content">

                @RenderBody()

            </main>

<!-- =================================================
     FOOTER
     ================================================= -->

<footer class="fb-footer">

    <div class="fb-footer-wave"></div>

    <div class="fb-footer-container">

        <div class="fb-footer-main">

            <!-- =================================================
                 BRAND
                 ================================================= -->

            <div class="fb-footer-brand">

                <a asp-controller="Home"
                   asp-action="Index"
                   class="fb-footer-logo">

                    <div class="fb-footer-logo-icon">
                        ✿
                    </div>

                    <div>
                        <div class="fb-footer-logo-title">
                            FirstBloom
                        </div>

                        <div class="fb-footer-logo-subtitle">
                            Academy
                        </div>
                    </div>

                </a>

                <p>
                    Nurturing young minds with care,
                    creativity and quality education.
                </p>

                <!-- SOCIAL MEDIA -->

                <div class="fb-social-icons">

                    <a href="https://www.facebook.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Facebook">

                        <i class="bi bi-facebook"></i>

                    </a>

                    <a href="https://www.instagram.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="Instagram">

                        <i class="bi bi-instagram"></i>

                    </a>

                    <a href="https://www.youtube.com/"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="YouTube">

                        <i class="bi bi-youtube"></i>

                    </a>

                </div>

            </div>


            <!-- =================================================
                 ABOUT / MAIN LINKS
                 ================================================= -->

            <div class="fb-footer-column">

                <h4>
                    Explore
                </h4>

                <ul>

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Home

                        </a>
                    </li>

                    <li>
                        <a asp-controller="About"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            About Us

                        </a>
                    </li>

                    <li>
                        <a asp-controller="Program"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Programs

                        </a>
                    </li>

                    <li>
                        <a asp-controller="Admissions"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Admissions

                        </a>
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 INFORMATION LINKS
                 ================================================= -->

            <div class="fb-footer-column">

                <h4>
                    Information
                </h4>

                <ul>

                    <li>
                        <a asp-controller="Gallery"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Gallery

                        </a>
                    </li>

                    <li>
                        <a asp-controller="Blog"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Blog

                        </a>
                    </li>

                    <li>
                        <a asp-controller="FAQ"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            FAQ

                        </a>
                    </li>

                    <li>
                        <a asp-controller="Contact"
                           asp-action="Index">

                            <i class="fa-solid fa-angle-right"></i>
                            Contact Us

                        </a>
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 CONTACT
                 ================================================= -->

            <div class="fb-footer-column">

                <h4>
                    Contact Us
                </h4>

                <div class="fb-contact-item">

                    <i class="bi bi-geo-alt-fill"></i>

                    <span>
                        11, FirstBloom Academy<br />
                        New City Light,<br />
                        Surat - 395007
                    </span>

                </div>


                <div class="fb-contact-item">

                    <i class="bi bi-telephone-fill"></i>

                    <span>
                        +91 99740 34290
                    </span>

                </div>


                <div class="fb-contact-item">

                    <i class="bi bi-envelope-fill"></i>

                    <span>
                        info@firstbloomacademy.com
                    </span>

                </div>


                <div class="fb-contact-item">

                    <i class="bi bi-clock-fill"></i>

                    <span>
                        Mon - Fri: 8:00 AM - 5:00 PM
                    </span>

                </div>

            </div>

        </div>


        <!-- =================================================
             FOOTER BOTTOM
             ================================================= -->

        <div class="fb-footer-bottom">

            <p>
                © 2026 FirstBloom Academy.
                All Rights Reserved.
            </p>

            <div class="fb-footer-legal">

                <a asp-controller="Home" asp-action="Privacy">
    Privacy Policy
</a>

                <span>|</span>

                <a asp-controller="Home" asp-action="Terms">
    Terms &amp; Conditions
</a>

            </div>

        </div>

    </div>

</footer>

            
        </div>

    </div>


    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/program-search.js"
        asp-append-version="true"></script>

    <script src="~/js/notifications.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)

</body>

</html>