                        </span>

                        <span class="fb-stat-label">
                            Expert Teachers
                        </span>
                    </div>

                </div>


                <div class="fb-stat-item">

                    <div class="fb-stat-icon">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <div>
                        <span class="fb-stat-number">
                            15+
                        </span>

                        <span class="fb-stat-label">
                            Learning Programs
                        </span>
                    </div>

                </div>


                <div class="fb-stat-item">

                    <div class="fb-stat-icon">
                        <i class="fa-solid fa-face-smile"></i>
