                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>


                <div class="fb-program-card">

                    <div class="fb-program-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <h3>
                        Senior KG
                    </h3>

                    <p>
                        Preparing children with strong foundations
                        for their next exciting educational journey.
                    </p>

                    <a href="/Program/Details/4"
                       class="fb-program-link">

                        Explore Program
                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>


                <div class="fb-program-card">

                    <div class="fb-program-icon">
                        <i class="fa-solid fa-palette"></i>
                    </div>

                    <h3>
                        Activity Classes
                    </h3>

                    <p>
                        Art, music, dance and creative activities
                        that allow every child to discover their talents.
                    </p>

                    <a href="/Program/Details/5"
                       class="fb-program-link">

                        Explore Program
                        <i class="fa-solid fa-arrow-right ms-2"></i>

                    </a>

                </div>


                <div class="fb-program-card">

                    <div class="fb-program-icon">
                        <i class="fa-solid fa-house-heart"></i>
                    </div>

