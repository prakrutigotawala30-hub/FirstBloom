@{
    ViewData["Title"] = "Home";
}
<link rel="stylesheet" href="~/css/Home/Index.css" />


<div class="fb-home">


    <!-- =====================================================
         HERO
         ===================================================== -->

    <section class="fb-home-hero">

        <div class="fb-hero-shape one"></div>
        <div class="fb-hero-shape two"></div>

        <div class="fb-home-container">

            <div class="fb-home-hero-content">


                <!-- Hero Content -->

                <div>

                    <div class="fb-hero-badge">

                        <i class="fa-solid fa-sparkles"></i>

                        Welcome to FirstBloom Academy

                    </div>


                    <h1>

                        Nurturing Young Minds,

                        <span>
                            Building Bright Futures
                        </span>

                    </h1>


                    <p class="fb-hero-description">

                        A joyful and caring place where children
                        learn, explore, create and grow with
                        confidence. We provide quality early
                        childhood education in a safe and
                        inspiring environment.

                    </p>


                    <div class="fb-hero-buttons">

                        <a asp-controller="Program"
                           asp-action="Index"
                           class="fb-btn-primary">

                            Explore Programs

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>


                        <a asp-controller="About"
                           asp-action="Index"
                           class="fb-btn-light">

                            Discover FirstBloom

                        </a>

                    </div>

                </div>


                <!-- Hero Image -->

                <div class="fb-hero-visual">

                    <div class="fb-hero-image-card">

                        <img src="https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=1000&q=85"
                             alt="Children learning at FirstBloom Academy" />

                        <div class="fb-hero-image-overlay"></div>

                    </div>


                    <div class="fb-hero-floating-card">

                        <div class="fb-floating-icon">

                            <i class="fa-solid fa-heart"></i>

                        </div>

                        <div class="fb-floating-text">

                            <strong>
                                Learning With Love
                            </strong>

                            <span>
                                Every child matters
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </section>



