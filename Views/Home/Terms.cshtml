@{
    ViewData["Title"] = "Terms & Conditions";
}

@section Styles {
    <link rel="stylesheet" href="~/css/terms.css" asp-append-version="true" />
}

<section class="fb-terms-page">

    <!-- Hero -->
    <div class="fb-terms-hero">

        <div class="fb-terms-icon">
            <i class="fa-solid fa-file-contract"></i>
        </div>

        <div>
            <span class="fb-terms-label">
