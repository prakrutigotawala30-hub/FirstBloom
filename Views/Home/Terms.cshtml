        </div>


        <!-- Contact -->
        <div class="fb-terms-contact">

            <div class="fb-terms-contact-icon">
                <i class="fa-solid fa-headset"></i>
            </div>

            <div>

                <h3>Need Help?</h3>

                <p>
                    If you have questions regarding these Terms &amp; Conditions,
