@{
    ViewData["Title"] = "Privacy Policy";
}

@section Styles {
    <link rel="stylesheet" href="~/css/privacy.css" asp-append-version="true" />
}

<section class="fb-privacy-page">

    <!-- Hero -->
    <div class="fb-privacy-hero">
        <div class="fb-privacy-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <div>
            <span class="fb-privacy-label">FIRSTBLOOM ACADEMY</span>

            <h1>Privacy Policy</h1>

            <p>
                Your privacy matters to us. Learn how FirstBloom Academy
                collects, uses and protects your information.
            </p>
        </div>
    </div>


    <!-- Main Content -->
    <div class="fb-privacy-card">

        <div class="fb-privacy-intro">
            <i class="fa-solid fa-heart"></i>

            <p>
                At <strong>FirstBloom Academy</strong>, we respect your privacy
                and are committed to protecting the personal information
                shared with us by students, parents, guardians and website
                visitors.
            </p>
        </div>


        <!-- Section 01 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">01</div>

            <div>
                <h2>Information We Collect</h2>

                <p>
                    We may collect information that you voluntarily provide
                    when using our website or contacting the academy.
                    This may include your name, email address, phone number,
                    address and information submitted through admission,
                    enquiry or contact forms.
                </p>
            </div>
        </div>


        <!-- Section 02 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">02</div>

            <div>
                <h2>How We Use Your Information</h2>

                <p>
                    The information provided to us may be used to process
                    admission applications, respond to enquiries, provide
                    requested services, communicate important information
                    and improve our website and academy services.
                </p>
            </div>
        </div>


        <!-- Section 03 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">03</div>

            <div>
                <h2>Protection of Your Information</h2>

                <p>
                    We take reasonable administrative and technical measures
                    to protect personal information from unauthorized access,
                    misuse, alteration or disclosure.
                </p>
            </div>
        </div>


        <!-- Section 04 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">04</div>

            <div>
                <h2>Cookies</h2>

                <p>
                    Our website may use cookies and similar technologies to
                    improve website functionality, remember preferences and
                    provide a better user experience.
                </p>
            </div>
        </div>


        <!-- Section 05 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">05</div>

            <div>
                <h2>Third-Party Services</h2>

                <p>
                    Some website features may use third-party services.
                    Information shared with such services is handled
                    according to their respective privacy policies.
                </p>
            </div>
        </div>


        <!-- Section 06 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">06</div>

            <div>
                <h2>Children's Privacy</h2>

                <p>
                    We take children's privacy seriously. Personal information
                    relating to children should be provided by a parent or
                    legal guardian through the appropriate academy process.
                </p>
            </div>
        </div>


        <!-- Section 07 -->
        <div class="fb-privacy-section">
            <div class="fb-privacy-number">07</div>

            <div>
                <h2>Your Rights</h2>

                <p>
                    You may contact FirstBloom Academy if you have questions
                    about the personal information we hold about you or if
                    you believe your information needs to be corrected or
                    updated.
                </p>
            </div>
        </div>


        <!-- Contact -->
        <div class="fb-privacy-contact">

            <div class="fb-privacy-contact-icon">
                <i class="fa-solid fa-envelope"></i>
            </div>

            <div>
                <h3>Questions About Privacy?</h3>

                <p>
                    If you have any questions about this Privacy Policy,
                    please contact FirstBloom Academy.
                </p>

                <a href="mailto:info@firstbloomacademy.com">
                    info@firstbloomacademy.com
                </a>
            </div>

        </div>


        <div class="fb-privacy-updated">
            <i class="fa-regular fa-calendar"></i>
            Last updated: October 2026
        </div>

    </div>

</section>