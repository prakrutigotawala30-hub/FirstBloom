@model FirstBloom.Models.Identity.ApplicationUser

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var application =
        ViewBag.Application
        as FirstBloom.Models.AdmissionApplication;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Student/student-account.css"
          asp-append-version="true" />
}

<div class="student-profile-page">

    <div class="student-profile-card">

        <!-- HEADER -->

        <div class="student-profile-header">

            <div class="student-profile-avatar">

                <i class="fa-solid fa-user"></i>

            </div>

            <div>

                <span>
                    FIRSTBLOOM ACADEMY
                </span>

                <h1>
                    My Profile
                </h1>

                <p>
                    Manage your student account information.
                </p>

            </div>

        </div>


        <!-- ACCOUNT INFORMATION -->

        <div class="student-profile-section">

            <div class="student-section-title">

                <i class="fa-solid fa-user-circle"></i>

                <h2>
                    Account Information
                </h2>

            </div>


            <div class="student-profile-grid">

                <div class="student-profile-item">

                    <span>
                        Full Name
                    </span>

                    <strong>
                        @Model.FullName
                    </strong>

                </div>


                <div class="student-profile-item">

                    <span>
                        Email Address
                    </span>

                    <strong>
                        @Model.Email
                    </strong>

                </div>


                <div class="student-profile-item">

                    <span>
                        Mobile Number
                    </span>

                    <strong>
                        @Model.PhoneNumber
                    </strong>

                </div>


                <div class="student-profile-item">

                    <span>
                        Email Status
                    </span>

                    @if (Model.EmailConfirmed)
                    {
                        <strong class="profile-status confirmed">

                            <i class="fa-solid fa-circle-check"></i>

                            Confirmed

                        </strong>
                    }
                    else
                    {
                        <strong class="profile-status pending">

                            <i class="fa-solid fa-clock"></i>

                            Not Confirmed

                        </strong>
                    }

                </div>

            </div>

        </div>


        <!-- APPLICATION -->
        @if (application != null)
        {
            <div class="student-profile-section">

                <div class="student-section-title">

                    <i class="fa-solid fa-file-lines"></i>

                    <h2>
                        Admission Application
                    </h2>

                </div>


                <div class="student-profile-grid">

                    <div class="student-profile-item">

                        <span>
                            Application Number
                        </span>

                        <strong>
                            @application.ApplicationNumber
                        </strong>

                    </div>


                    <div class="student-profile-item">

                        <span>
                            Application Status
                        </span>

                        <strong class="profile-status">

                            @application.Status

                        </strong>

                    </div>


                    <div class="student-profile-item">

                        <span>
                            Current Step
                        </span>

                        <strong>
                            @application.CurrentStep / 6
                        </strong>

                    </div>


                    <div class="student-profile-item">

                        <span>
                            Application Date
                        </span>

                        <strong>
                            @application.CreatedAt.ToString("dd MMM yyyy")
                        </strong>

                    </div>

                </div>

            </div>
        }


        <!-- ACTIONS -->

        <div class="student-profile-actions">

            @if (application != null &&
                application.Status ==
                FirstBloom.Models.AdmissionStatus.Approved)
            {
                <a asp-controller="StudentDashboard"
                   asp-action="Index"
                   class="student-primary-button">

                    <i class="fa-solid fa-gauge-high"></i>

                    Student Dashboard

                </a>
            }

            <a asp-controller="Home"
               asp-action="Index"
               class="student-outline-button">

                <i class="fa-solid fa-house"></i>

                Home

            </a>

        </div>

    </div>

</div>