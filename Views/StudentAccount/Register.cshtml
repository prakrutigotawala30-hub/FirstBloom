@model FirstBloom.Models.Student.StudentRegisterModel

@{
    ViewData["Title"] = "Student Registration";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/Student/student-account.css"
          asp-append-version="true" />
}
<div class="student-auth-page">

    <div class="student-auth-card">

        <div class="student-auth-header">

            <div class="student-auth-icon">
                <i class="fa-solid fa-user-plus"></i>
            </div>

            <span>FIRSTBLOOM ACADEMY</span>

            <h1>Create Your Account</h1>

            <p>
                Register to start your FirstBloom admission application.
            </p>

        </div>


        <form asp-action="Register"
              asp-controller="StudentAccount"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />


            <div asp-validation-summary="ModelOnly"
                 class="student-validation">
            </div>


            <!-- FULL NAME -->

            <div class="student-form-group">

                <label asp-for="FullName"></label>

                <div class="student-input">

                    <i class="fa-solid fa-user"></i>

                    <input asp-for="FullName"
                           placeholder="Enter your full name" />

                </div>

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>

            </div>


            <!-- EMAIL -->

            <div class="student-form-group">

                <label asp-for="Email"></label>

                <div class="student-input">

                    <i class="fa-solid fa-envelope"></i>

                    <input asp-for="Email"
                           placeholder="Enter your email address" />

                </div>

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- MOBILE -->

            <div class="student-form-group">

                <label asp-for="Mobile"></label>

                <div class="student-input">

                    <i class="fa-solid fa-phone"></i>

                    <input asp-for="Mobile"
                           placeholder="Enter your mobile number" />

                </div>

                <span asp-validation-for="Mobile"
                      class="text-danger">
                </span>

            </div>


            <!-- PASSWORD -->

            <div class="student-form-group">

                <label asp-for="Password"></label>

                <div class="student-input">

                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Password"
                           placeholder="Create a password" />

                </div>

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="student-form-group">

                <label asp-for="ConfirmPassword"></label>

                <div class="student-input">

                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="ConfirmPassword"
                           placeholder="Confirm your password" />

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="student-auth-button">

                <span>Create Account</span>

                <i class="fa-solid fa-arrow-right"></i>

            </button>


            <div class="student-auth-footer">

                Already have an account?

                <a asp-controller="StudentAccount"
                   asp-action="Login">

                    Login here

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}